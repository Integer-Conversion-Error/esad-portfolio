---
interface Props {
  company: string;
}

const { company } = Astro.props;

// Source URLs and asset provenance are recorded beside the local images.
const logos: Record<string, string> = {
  Entrust: "entrust.svg",
  Solace: "solace.svg",
  "Communications Research Center": "canada.svg",
  "Communications Research Centre": "canada.svg",
  "HR – Infrastructure Canada": "canada.svg",
  "Raindrop Janitorial Services Corp.": "raindrop.webp",
};

const logo = logos[company];
---

{logo && (
  <span class="organization-logo" aria-hidden="true">
    <img
      src={"/images/organizations/" + logo}
      alt=""
      width="112"
      height="48"
      loading="lazy"
      decoding="async"
    />
  </span>
)}

<style>
  .organization-logo {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 112px;
    height: 48px;
    padding: 6px 8px;
    background: #fff;
  }

  .organization-logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
