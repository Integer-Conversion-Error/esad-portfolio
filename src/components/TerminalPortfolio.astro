<script>
  const nav = document.querySelector<HTMLElement>("[data-tp-nav]");
  const menu = document.querySelector<HTMLButtonElement>("[data-tp-menu]");
  const drawer = document.querySelector<HTMLElement>("[data-tp-drawer]");
  if (nav && menu && drawer) {
    const close = () => {
      nav.classList.remove("is-open");
      menu.setAttribute("aria-expanded", "false");
      menu.setAttribute("aria-label", "Open navigation");
      drawer.setAttribute("aria-hidden", "true");
      drawer.inert = true;
      document.body.style.overflow = "";
    };
    menu.addEventListener("click", () => {
      const open = nav.classList.toggle("is-open");
      menu.setAttribute("aria-expanded", String(open));
      menu.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
      drawer.setAttribute("aria-hidden", String(!open));
      drawer.inert = !open;
      document.body.style.overflow = open ? "hidden" : "";
    });
    drawer.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("is-open")) {
        close();
        menu.focus();
      }
    });
    window.addEventListener("resize", () => {
      if (window.innerWidth > 800 && nav.classList.contains("is-open")) close();
    });
  }
</script>
