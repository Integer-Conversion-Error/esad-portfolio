---
import { experience, leadProjects, personal, smallProjects } from "../lib/data";
import { caseStudies, caseStudyHref } from "../lib/case-studies";
import Nav from "./Nav.astro";

const hasCaseStudy = (slug: string) => caseStudies.some((project) => project.slug === slug);
const additionalProjects = caseStudies.filter((project) => !leadProjects.some((lead) => lead.slug === project.slug));
---

<div class="portfolio" id="top">
  <a class="skip-link" href="#work">Skip to selected work</a>
  <Nav />

  <div class="portfolio-shell">
    <section class="intro" id="about" aria-labelledby="intro-title">
      <h1 id="intro-title">I build software<br />for work and home.</h1>
      <p>
        I'm finishing a CS degree at the University of Ottawa in May 2027.
        I like working across the interface, backend, and hardware.
      </p>
      <div class="resume-links" id="resume" aria-label="Résumé">
        <a href="/resume.pdf" target="_blank" rel="noopener">View résumé <span aria-hidden="true">↗</span></a>
        <a href="/resume.pdf" download>Download PDF <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section class="work section" id="work" aria-labelledby="work-title">
      <h2 id="work-title">Selected work</h2>
      <div class="projects">
        {leadProjects.map((project) => (
          <article class="project" id={project.slug}>
            <div class="project-heading">
              <h3>{hasCaseStudy(project.slug) ? <a href={caseStudyHref(project.slug)}>{project.title}</a> : project.title}</h3>
              <p class="date">{project.year}</p>
            </div>
            <div class="project-body">
              <p class="project-outcome">{project.outcome}</p>
              <p class="project-evidence">{project.evidence}</p>
              {(hasCaseStudy(project.slug) || project.url || project.github) && (
                <div class="project-links">
                  {hasCaseStudy(project.slug) && <a href={caseStudyHref(project.slug)}>Case study <span aria-hidden="true">→</span></a>}
                  {project.url && <a href={project.url} target="_blank" rel="noopener">Visit site <span aria-hidden="true">↗</span></a>}
                  {project.github && <a href={project.github} target="_blank" rel="noopener">Source <span aria-hidden="true">↗</span></a>}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>

      <section class="other-work" aria-labelledby="other-work-title">
        <h3 id="other-work-title">Other projects</h3>
        {additionalProjects.map((project) => (
          <article class="other-project" id={project.slug}>
            <h4><a href={caseStudyHref(project.slug)}>{project.title}</a></h4>
            <p>{project.summary}</p>
            <a href={caseStudyHref(project.slug)} aria-label={"Read " + project.title + " case study"}>Case study <span aria-hidden="true">→</span></a>
          </article>
        ))}
        {smallProjects.map((project) => (
          <article class="other-project" id={project.slug}>
            <h4>{project.title}</h4>
            <p>{project.description}</p>
            {project.github && <a href={project.github} target="_blank" rel="noopener" aria-label={"Open " + project.title + " source"}>Source <span aria-hidden="true">↗</span></a>}
          </article>
        ))}
      </section>
    </section>

    <section class="section" id="record" aria-labelledby="record-title">
      <h2 id="record-title">Experience</h2>
      {experience.map((role) => (
        <article class="experience-row">
          <div>
            <h3>{role.company}</h3>
            <p class="role">{role.role}</p>
            <p class="date">{role.start} – {role.end}</p>
          </div>
          <p class="experience-result">{role.result}</p>
        </article>
      ))}
    </section>

    <section class="contact section" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Contact</h2>
      <p>Available for Summer 2027 roles and contract work.</p>
      <a class="email" href={"mailto:" + personal.email}>{personal.email}</a>
      <div class="profile-links">
        <a href={personal.links.github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
        <a href={personal.links.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <footer class="portfolio-footer"><a href="#top">Back to top <span aria-hidden="true">↑</span></a></footer>
  </div>
</div>

<style>
  .portfolio {
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-sans);
  }
  .portfolio-shell {
    width: min(100%, 1120px);
    margin-inline: auto;
    padding-inline: 48px;
  }
  .portfolio section[id], .resume-links { scroll-margin-top: 96px; }
  .portfolio a:hover { color: var(--accent); }
  .intro { padding-block: 88px 64px; }
  .intro h1 {
    font-size: clamp(36px, 4.8vw, 56px);
    line-height: 1.12;
    letter-spacing: -0.045em;
    font-weight: 500;
  }
  .intro > p {
    max-width: 58ch;
    margin-top: 24px;
    color: var(--ink-muted);
    font-size: 17px;
    line-height: 1.7;
  }
  .resume-links, .project-links, .profile-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 24px;
  }
  .resume-links { margin-top: 20px; }
  .resume-links a, .project-links a, .profile-links a, .other-project > a, .portfolio-footer a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-size: 14px;
    text-decoration: none;
  }
  .portfolio a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .section { padding-block: 48px; border-top: 1px solid var(--rule); }
  .section > h2 { margin-bottom: 12px; font-size: 24px; letter-spacing: -0.035em; }
  .project, .experience-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 48px;
    padding-block: 28px;
  }
  .project + .project, .experience-row + .experience-row { border-top: 1px solid var(--rule); }
  .project h3, .experience-row h3 { font-size: 19px; line-height: 1.4; letter-spacing: -0.025em; overflow-wrap: anywhere; }
  .project h3 a, .other-project h4 a { text-decoration: none; }
  .date { margin-top: 8px; color: var(--ink-subtle); font-family: var(--font-mono); font-size: 12px; line-height: 1.7; }
  .project-outcome, .experience-result { font-size: 16px; line-height: 1.65; }
  .project-evidence { margin-top: 8px; color: var(--ink-muted); font-size: 14px; line-height: 1.7; }
  .project-links { margin-top: 8px; }
  .other-work { margin-top: 28px; }
  .other-work > h3 { padding-bottom: 20px; font-size: 20px; letter-spacing: -0.025em; }
  .other-project {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) auto;
    align-items: baseline;
    gap: 24px;
    border-top: 1px solid var(--rule);
    padding-block: 16px;
  }
  .other-project h4 { font-size: 16px; line-height: 1.5; letter-spacing: -0.02em; }
  .other-project p { color: var(--ink-muted); font-size: 14px; line-height: 1.7; }
  .other-project > a { white-space: nowrap; }
  .role { margin-top: 6px; color: var(--ink-muted); font-size: 14px; line-height: 1.6; }
  .contact > p { margin-top: 20px; color: var(--ink-muted); font-size: 16px; line-height: 1.6; }
  .email { display: inline-block; margin-top: 12px; color: var(--ink); font-size: clamp(21px, 3vw, 28px); line-height: 1.5; letter-spacing: -0.025em; overflow-wrap: anywhere; }
  .profile-links { margin-top: 16px; }
  .portfolio-footer { display: flex; justify-content: flex-end; padding-block: 12px 24px; border-top: 1px solid var(--rule); }
  .portfolio-footer a { color: var(--ink-muted); }
  @media (max-width: 700px) {
    .portfolio-shell { padding-inline: 24px; }
    .intro { padding-block: 56px 40px; }
    .intro > p { font-size: 16px; }
    .section { padding-block: 32px; }
    .section > h2 { font-size: 22px; }
    .project, .experience-row { grid-template-columns: 1fr; gap: 14px; padding-block: 24px; }
    .other-project { grid-template-columns: 1fr auto; gap: 6px 16px; }
    .other-project p { grid-column: 1 / -1; grid-row: 2; }
    .other-project > a { min-height: 36px; }
  }
</style>
