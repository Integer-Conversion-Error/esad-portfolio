---
import { personal } from "../lib/data";
---

<section id="contact" class="contact section" aria-labelledby="contact-title">
  <div class="container">
    <div class="head">
      <span class="micro label">Contact</span>
      <h2 id="contact-title" class="display-headline">Get in touch.</h2>
      <p class="body-lg lede">
        Email is best. I'm open to internships, contract work, and selected independent
        projects.
      </p>
    </div>

    <div class="actions">
      <a
        class="btn btn-accent"
        href={`mailto:${personal.email}`}
        aria-label={`Email ${personal.name}`}
      >
        {personal.email}
      </a>

      <div class="secondary">
        <a class="btn btn-secondary" href={personal.links.linkedin} rel="noopener" target="_blank">
          LinkedIn →
        </a>
        <a class="btn btn-secondary" href={personal.links.github} rel="noopener" target="_blank">
          GitHub →
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--rule);
  }

  .head {
    margin-bottom: 48px;
  }

  .label {
    color: var(--ink-subtle);
    display: block;
    margin-bottom: 24px;
  }

  .display-headline {
    font-family: var(--font-display);
    font-size: clamp(48px, 7vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 500;
    color: var(--ink);
    margin: 0 0 32px;
  }

  .lede {
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-muted);
    margin: 0;
    max-width: 36rem;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .actions {
      flex-direction: row;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
    }
  }

  .secondary {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Buttons — 44px tall per design system */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 20px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      background-color var(--duration-instant) var(--ease-standard),
      color var(--duration-instant) var(--ease-standard),
      opacity var(--duration-instant) var(--ease-standard);
  }

  .btn-accent {
    background: var(--accent);
    color: var(--bg);
  }
  .btn-accent:hover {
    background: var(--accent-hover);
  }

  .btn-secondary {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--rule-strong);
  }
  .btn-secondary:hover {
    background: var(--bg-elevated);
    color: var(--accent);
    border-color: var(--ink);
  }
</style>
