---
import { experience, leadProjects, personal, skills, smallProjects } from "../lib/data";
import ProjectVisual from "./ProjectVisual.astro";

const year = new Date().getFullYear();

const facts = [
  { label: "Based in", value: "Ottawa, Canada" },
  { label: "Available", value: "Summer 2027" },
  { label: "First language", value: "C / grade 11" },
  { label: "Outside work", value: "3D printing and home lab" },
];
---

<div class="cp" id="top">
  <a class="cp-skip" href="#work">Skip to selected work</a>

  <header class="cp-nav" data-cp-nav>
    <div class="cp-shell cp-nav-inner">
      <a class="cp-mark" href="#top" aria-label={`${personal.name} - back to top`}>EK</a>

      <nav class="cp-nav-links" aria-label="Primary">
        <a href="#work">Work</a>
        <a href="#record">Record</a>
        <a href="#resume">Resume</a>
        <a href="#about">About</a>
        <a href="/blog">Writing</a>
      </nav>

      <a class="cp-nav-contact" href="#contact">Contact <span aria-hidden="true">-></span></a>

      <button class="cp-menu" type="button" data-cp-menu aria-label="Open navigation" aria-expanded="false">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>

    <div class="cp-drawer" data-cp-drawer aria-hidden="true">
      <nav aria-label="Mobile navigation">
        <a href="#work">Work</a>
        <a href="#record">Record</a>
        <a href="#resume">Resume</a>
        <a href="#about">About</a>
        <a href="/blog">Writing</a>
        <a href="#contact">Contact</a>
      </nav>
      <p>{personal.status}</p>
    </div>
  </header>

  <section class="cp-hero" aria-labelledby="cp-hero-title">
    <div class="cp-shell">
      <div class="cp-hero-topline">
        <p>Esad Kaya / software + hardware</p>
        <p>Ottawa / 45.4215 N, 75.6972 W</p>
      </div>

      <div class="cp-hero-main">
        <p class="cp-kicker">Independent systems / 2026</p>
        <h1 id="cp-hero-title">Real<br />projects,<br /><span>real solutions</span></h1>
      </div>

      <div class="cp-hero-bottom">
        <div class="cp-hero-copy">
          <p class="cp-hero-lede">
            I build software for work and home: workforce tools for crews in Ottawa, payroll
            systems for a family business, and a local intercom for the house.
          </p>
          <a class="cp-hero-resume" href="#resume">View resume <span aria-hidden="true">-&gt;</span></a>
        </div>

        <dl class="cp-hero-stats">
          <div>
            <dt>Current</dt>
            <dd>Software engineer intern</dd>
          </div>
          <div>
            <dt>Working on</dt>
            <dd>Field-work systems and local hardware</dd>
          </div>
          <div>
            <dt>Open to</dt>
            <dd>Internships and contract work</dd>
          </div>
        </dl>

        <div class="cp-hero-mark" aria-hidden="true">EK</div>
      </div>
    </div>
  </section>

  <section class="cp-work" id="work" aria-labelledby="work-title">
    <div class="cp-shell">
      <header class="cp-section-head">
        <h2 id="work-title">Selected work.</h2>
        <p class="cp-section-detail">2025-2026 / software and hardware</p>
      </header>

      <div class="cp-projects">
        {
          leadProjects.map((project, index) => (
            <article class={`cp-project ${index === 0 ? "is-lead" : ""}`} id={project.slug}>
              <div class="cp-project-number">{String(index + 1).padStart(2, "0")}</div>

              <div class="cp-project-copy">
                <p class="cp-project-role">{project.role}</p>
                <h3>{project.title}</h3>
                <p class="cp-project-subtitle">{project.subtitle}</p>
                <p class="cp-project-narrative">{project.narrative}</p>

                <div class="cp-project-meta">
                  <p>{project.year}</p>
                  <p>{project.stack.join(" / ")}</p>
                </div>

                {(project.url || project.github) && (
                  <div class="cp-project-actions">
                    {project.url && (
                      <a href={project.url} target="_blank" rel="noopener">Visit site <span aria-hidden="true">-></span></a>
                    )}
                    {project.github && (
                      <a href={project.github} target="_blank" rel="noopener">Source <span aria-hidden="true">-></span></a>
                    )}
                  </div>
                )}
              </div>

              <div class="cp-project-visual">
                <p>Fig. {String(index + 1).padStart(2, "0")}</p>
                <ProjectVisual hint={project.visualHint} />
              </div>

              <span class="cp-project-arrow" aria-hidden="true">↗</span>
            </article>
          ))
        }
      </div>

      <div class="cp-work-signoff">
        <p>Web, mobile, embedded systems, and operations.</p>
        <p>{leadProjects.length} public records</p>
      </div>
    </div>
  </section>

  <section class="cp-about" id="about" aria-labelledby="about-title">
    <div class="cp-shell cp-about-grid">
      <p class="cp-section-number">02 / About</p>
      <div class="cp-about-copy">
        <h2 id="about-title">I build software for <span>practical problems.</span></h2>
        <div class="cp-about-prose">
          <p>
            I'm finishing a CS degree at the University of Ottawa in May 2027. Since 2020,
            I've also worked as the technical support person at my family's janitorial company.
            I manage payroll for more than fifty people, maintain the office network, and am
            replacing the dispatch spreadsheet with an internal system.
          </p>
          <p>
            I started with C and an Arduino project. Now I work on local AI, embedded hardware,
            and web systems. I also 3D print parts and maintain a small home lab for testing.
          </p>
        </div>
      </div>

      <dl class="cp-facts">
        {
          facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="cp-record" id="record" aria-labelledby="record-title">
    <div class="cp-shell">
      <header class="cp-section-head cp-section-head-record">
        <h2 id="record-title">Where I've worked.</h2>
        <p class="cp-section-detail">Selected roles and results</p>
      </header>

      <div class="cp-record-list">
        {
          experience.map((role) => (
            <article class="cp-record-entry">
              <p class="cp-record-year">{role.year}</p>
              <div class="cp-record-main">
                <h3>{role.role} <span>at</span> {role.company}</h3>
                <p class="cp-record-meta">{role.location} / {role.start} - {role.end}</p>
                <ul>
                  {role.highlights.slice(0, 2).map((highlight) => <li>{highlight}</li>)}
                </ul>
              </div>
              <p class="cp-record-index">{String(role.year).slice(-2)}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cp-resume" id="resume" aria-labelledby="resume-title">
    <div class="cp-shell">
      <header class="cp-section-head">
        <h2 id="resume-title">Resume.</h2>
        <p class="cp-section-detail">Current PDF / 4 pages</p>
      </header>

      <div class="cp-resume-intro">
        <p class="cp-resume-note">A current summary of experience, education, and technical work.</p>
        <div class="cp-resume-actions">
          <a href="/resume.pdf" target="_blank" rel="noopener">Open PDF <span aria-hidden="true">-&gt;</span></a>
          <a href="/resume.pdf" download>Download PDF <span aria-hidden="true">-&gt;</span></a>
        </div>
      </div>

      <div class="cp-resume-viewer">
        <iframe src="/resume.pdf#view=FitH" title="Esad Kaya resume"></iframe>
      </div>
    </div>
  </section>

  <section class="cp-toolbox" aria-labelledby="toolbox-title">
    <div class="cp-shell">
      <header class="cp-section-head">
        <h2 id="toolbox-title">Tools and technologies.</h2>
        <p class="cp-section-detail">Current working set</p>
      </header>

      <div class="cp-skill-groups">
        {
          skills.map((group) => (
            <section class="cp-skill-group">
              <h3>{group.label}</h3>
              <ul>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cp-small" aria-labelledby="small-title">
    <div class="cp-shell">
      <header class="cp-section-head cp-section-head-small">
        <h2 id="small-title">Other projects.</h2>
        <p class="cp-section-detail">Selected side projects</p>
      </header>

      <div class="cp-small-list">
        {
          smallProjects.map((project) => (
            <article class="cp-small-project">
              <p>{project.index}</p>
              <div>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
              </div>
              <p>{project.stack.join(" / ")}</p>
              {project.github ? (
                <a href={project.github} target="_blank" rel="noopener" aria-label={`Open ${project.title} source`}>↗</a>
              ) : (
                <span aria-hidden="true">-</span>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cp-contact" id="contact" aria-labelledby="contact-title">
    <div class="cp-shell cp-contact-grid">
      <p class="cp-section-number">07 / Contact</p>
      <div>
        <h2 id="contact-title">Let's work on <span>something useful.</span></h2>
        <p>
          I'm available for Summer 2027 roles, contract work, and selected independent projects.
        </p>
        <a class="cp-email" href={`mailto:${personal.email}`}>
          <span class="cp-email-address">{personal.email}</span>
          <span aria-hidden="true">-></span>
        </a>
      </div>
      <div class="cp-contact-links">
        <a href={personal.links.github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">-></span></a>
        <a href={personal.links.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">-></span></a>
      </div>
    </div>
  </section>

  <footer class="cp-footer">
    <div class="cp-shell cp-footer-inner">
      <p>Esad Kaya / Ottawa</p>
      <p>Built with Astro / {year}</p>
      <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </footer>
</div>

<style>
  .cp {
    --cp-black: #080808;
    --cp-red: #e3153b;
    --cp-red-deep: #8d1028;
    --cp-paper: #f4f1eb;
    --cp-muted: #aaa39d;
    --cp-rule: #55101d;
    min-height: 100vh;
    overflow-x: clip;
    background: var(--cp-black);
    color: var(--cp-paper);
    --ink: var(--cp-paper);
    --accent: var(--cp-red);
  }

  .cp *,
  .cp *::before,
  .cp *::after {
    box-sizing: border-box;
  }

  .cp a {
    color: inherit;
  }

  .cp-shell {
    width: min(100%, 1440px);
    margin: 0 auto;
    padding-left: 72px;
    padding-right: 72px;
  }

  .cp-skip {
    position: fixed;
    z-index: 100;
    top: 16px;
    left: 16px;
    padding: 12px 16px;
    background: var(--cp-red);
    color: var(--cp-black);
    font-family: var(--font-mono);
    font-size: 12px;
    transform: translateY(-200%);
    transition: transform 160ms ease;
  }

  .cp-skip:focus {
    transform: translateY(0);
  }

  .cp section[id] {
    scroll-margin-top: 64px;
  }

  .cp-nav {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--cp-rule);
    background: var(--cp-black);
  }

  .cp-nav-inner {
    min-height: 64px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }

  .cp-mark,
  .cp-nav-links a,
  .cp-nav-contact,
  .cp-menu,
  .cp-drawer,
  .cp-hero-topline,
  .cp-kicker,
  .cp-hero-stats dt,
  .cp-section-head p,
  .cp-section-number,
  .cp-project-number,
  .cp-project-role,
  .cp-project-meta,
  .cp-project-actions,
  .cp-project-visual > p,
  .cp-project-arrow,
  .cp-work-signoff,
  .cp-facts dt,
  .cp-record-year,
  .cp-record-meta,
  .cp-record-index,
  .cp-skill-group h3,
  .cp-small-project > p,
  .cp-small-project > span,
  .cp-small-project > a,
  .cp-contact-links,
  .cp-footer {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cp-mark {
    color: var(--cp-paper);
    font-size: 14px;
    text-decoration: none;
  }

  .cp-nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .cp-nav-links a,
  .cp-nav-contact {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-bottom: 1px solid transparent;
    color: var(--cp-paper);
    text-decoration: none;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .cp-nav-links a:hover,
  .cp-nav-contact:hover {
    border-bottom-color: var(--cp-red);
    color: var(--cp-red);
  }

  .cp-nav-contact {
    justify-self: end;
    color: var(--cp-red);
  }

  .cp-nav-contact span,
  .cp-project-actions span,
  .cp-contact-links span,
  .cp-email span {
    color: var(--cp-red);
  }

  .cp-menu,
  .cp-drawer {
    display: none;
  }

  .cp-hero {
    border-bottom: 1px solid var(--cp-red);
  }

  .cp-hero .cp-shell {
    padding-top: 28px;
    padding-bottom: 24px;
  }

  .cp-hero-topline {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    color: var(--cp-muted);
  }

  .cp-hero-topline p:last-child {
    text-align: right;
  }

  .cp-hero-main {
    padding: 60px 0 32px;
  }

  .cp-kicker {
    margin-bottom: 28px;
    color: var(--cp-red);
  }

  .cp-hero h1 {
    max-width: 7ch;
    color: var(--cp-paper);
    font-family: var(--font-display);
    font-size: 144px;
    font-weight: 600;
    line-height: 0.76;
    letter-spacing: 0;
  }

  .cp-hero h1 span,
  .cp-about h2 span,
  .cp-contact h2 span {
    color: var(--cp-red);
  }

  .cp-hero-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.7fr) minmax(140px, 0.25fr);
    gap: 40px;
    align-items: end;
  }

  .cp-hero-lede {
    color: var(--cp-paper);
    font-family: var(--font-serif);
    font-size: 30px;
    line-height: 1.08;
  }

  .cp-hero-copy {
    max-width: 36ch;
  }

  .cp-hero-resume {
    display: inline-flex;
    gap: 10px;
    margin-top: 28px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--cp-red);
    color: var(--cp-paper);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .cp-hero-resume span {
    color: var(--cp-red);
  }

  .cp-hero-resume:hover {
    color: var(--cp-red);
  }

  .cp-hero-stats {
    display: grid;
    gap: 18px;
    margin: 0;
  }

  .cp-hero-stats div {
    padding-top: 10px;
    border-top: 1px solid var(--cp-rule);
  }

  .cp-hero-stats dt {
    margin-bottom: 4px;
    color: var(--cp-red);
  }

  .cp-hero-stats dd {
    margin: 0;
    color: var(--cp-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .cp-hero-mark {
    justify-self: end;
    color: transparent;
    font-family: var(--font-display);
    font-size: 160px;
    font-weight: 600;
    line-height: 0.72;
    letter-spacing: 0;
    -webkit-text-stroke: 1px var(--cp-red);
    text-stroke: 1px var(--cp-red);
  }

  .cp-work,
  .cp-record,
  .cp-resume,
  .cp-small {
    border-bottom: 1px solid var(--cp-red);
  }

  .cp-work .cp-shell,
  .cp-record .cp-shell,
  .cp-resume .cp-shell,
  .cp-small .cp-shell,
  .cp-toolbox .cp-shell {
    padding-top: 120px;
    padding-bottom: 120px;
  }

  .cp-work .cp-shell {
    padding-top: 48px;
  }

  .cp-resume-intro {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    align-items: end;
    padding: 28px 0 0;
  }

  .cp-resume-note {
    max-width: 32ch;
    color: var(--cp-muted);
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.12;
  }

  .cp-resume-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cp-resume-actions a {
    padding-bottom: 4px;
    border-bottom: 1px solid var(--cp-red-deep);
    color: var(--cp-paper);
    text-decoration: none;
  }

  .cp-resume-actions a:hover {
    border-bottom-color: var(--cp-red);
    color: var(--cp-red);
  }

  .cp-resume-actions span {
    color: var(--cp-red);
  }

  .cp-resume-viewer {
    height: auto;
    aspect-ratio: 612 / 840;
    margin-top: 40px;
    border: 1px solid var(--cp-red-deep);
    background: #0d0d0d;
  }

  .cp-resume-viewer iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--cp-paper);
  }

  .cp-section-head {
    display: grid;
    grid-template-columns: minmax(0, 2.4fr) 1fr;
    gap: 24px;
    align-items: end;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--cp-red);
  }

  .cp-section-detail {
    justify-self: end;
    color: var(--cp-muted);
    text-align: right;
  }

  .cp-section-head h2 {
    color: var(--cp-paper);
    font-family: var(--font-display);
    font-size: 68px;
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: 0;
  }

  .cp-projects {
    border-bottom: 1px solid var(--cp-rule);
  }

  .cp-project {
    display: grid;
    grid-template-columns: 56px minmax(360px, 1fr) minmax(280px, 0.85fr) 28px;
    gap: 32px;
    align-items: start;
    padding: 52px 0;
    border-top: 1px solid var(--cp-rule);
  }

  .cp-project.is-lead {
    padding-top: 64px;
  }

  .cp-project-number,
  .cp-project-arrow {
    color: var(--cp-red);
  }

  .cp-project-copy {
    min-width: 0;
  }

  .cp-project-role {
    margin-bottom: 12px;
    color: var(--cp-red);
  }

  .cp-project-copy h3 {
    margin-bottom: 8px;
    color: var(--cp-paper);
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: 0;
  }

  .cp-project-subtitle {
    margin-bottom: 24px;
    color: var(--cp-paper);
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.1;
  }

  .cp-project-narrative {
    max-width: 56ch;
    color: var(--cp-muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .cp-project-meta {
    display: grid;
    gap: 8px;
    margin-top: 28px;
    padding-top: 14px;
    border-top: 1px solid var(--cp-rule);
    color: var(--cp-muted);
  }

  .cp-project-meta p:last-child {
    color: var(--cp-red);
  }

  .cp-project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 20px;
  }

  .cp-project-actions a,
  .cp-contact-links a {
    padding-bottom: 4px;
    border-bottom: 1px solid var(--cp-red-deep);
    text-decoration: none;
  }

  .cp-project-actions a:hover,
  .cp-contact-links a:hover {
    border-bottom-color: var(--cp-red);
    color: var(--cp-red);
  }

  .cp-project-visual {
    min-height: 300px;
    display: grid;
    align-content: space-between;
    padding: 16px;
    border: 1px solid var(--cp-red-deep);
    background: #0d0d0d;
    color: var(--cp-paper);
  }

  .cp-project-visual > p {
    color: var(--cp-red);
  }

  .cp-project-visual :global(.illus) {
    align-self: center;
    margin: 24px auto 8px;
  }

  .cp-project-visual :global(img.illus) {
    filter: grayscale(1) contrast(1.25);
  }

  .cp-project-arrow {
    justify-self: end;
    font-size: 18px;
  }

  .cp-work-signoff,
  .cp-footer-inner,
  .crimson-empty {
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }

  .cp-work-signoff {
    padding-top: 18px;
    color: var(--cp-red);
  }

  .cp-about {
    border-bottom: 1px solid var(--cp-red);
    background: var(--cp-red);
    color: var(--cp-black);
  }

  .cp-about-grid {
    display: grid;
    grid-template-columns: minmax(150px, 0.35fr) minmax(0, 1.45fr) minmax(200px, 0.5fr);
    gap: 48px;
    padding-top: 120px;
    padding-bottom: 120px;
  }

  .cp-section-number {
    color: var(--cp-black);
  }

  .cp-about-copy h2,
  .cp-contact h2 {
    max-width: 11ch;
    color: var(--cp-black);
    font-family: var(--font-display);
    font-size: 88px;
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: 0;
  }

  .cp-about h2 span {
    color: var(--cp-paper);
  }

  .cp-about-prose {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-top: 48px;
