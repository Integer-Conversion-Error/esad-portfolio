---
import { personal } from "../lib/data";

const path = Astro.url.pathname;
const isHome = path === "/" || path === "/index.html";

const navItems = [
  { label: "Work", href: isHome ? "#work" : "/#work" },
  { label: "Experience", href: isHome ? "#record" : "/#record" },
  { label: "About", href: isHome ? "#about" : "/#about" },
  { label: "Resume", href: isHome ? "#resume" : "/#resume" },
  { label: "Writing", href: "/blog" },
];
---

<header class="nav" data-nav>
  <div class="nav-inner">
    <a href="/" class="monogram" aria-label={`${personal.name} — home`}>EK</a>

    <nav class="nav-links" aria-label="Primary">
      {
        navItems.map((item) => (
          <a href={item.href} class="nav-link" aria-current={item.href === "/blog" && path.startsWith("/blog") ? "page" : undefined}>{item.label}</a>
        ))
      }
    </nav>

    <a href={isHome ? "#contact" : "/#contact"} class="nav-contact">Contact <span aria-hidden="true">↗</span></a>

    <button class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-navigation" data-nav-toggle>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div id="mobile-navigation" class="nav-drawer" data-nav-drawer aria-hidden="true" inert>
  <nav aria-label="Mobile navigation">
    {
      navItems.map((item) => (
        <a href={item.href} class="drawer-link" aria-current={item.href === "/blog" && path.startsWith("/blog") ? "page" : undefined}>{item.label}</a>
      ))
    }
    <a href={isHome ? "#contact" : "/#contact"} class="drawer-link">Contact</a>
  </nav>
</div>

<style>
  .nav {
    --nav-bg: #0b0a0d;
    --nav-ink: #f4f1eb;
    --nav-orange: #e99855;
    --nav-rule: #51454b;
    position: sticky;
    top: 0;
    z-index: 50;
    height: 68px;
    border-bottom: 1px solid var(--nav-rule);
    background: var(--nav-bg);
    color: var(--nav-ink);
  }

  .nav-inner {
    width: min(100%, 1440px);
    height: 100%;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 72px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }

  .monogram,
  .nav-link,
  .nav-contact,
  .nav-toggle,
  .nav-drawer {
    font-family: var(--font-mono);
  }

  .monogram {
    width: fit-content;
    color: var(--nav-ink);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.04em;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    gap: clamp(14px, 2.1vw, 28px);
  }

  .nav-link,
  .nav-contact {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-bottom: 1px solid transparent;
    color: var(--nav-ink);
    font-size: 13px;
    text-decoration: none;
    transition: border-color 160ms ease, color 160ms ease;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"],
  .nav-contact:hover {
    border-bottom-color: var(--nav-orange);
    color: var(--nav-orange);
  }

  .nav-contact {
    justify-self: end;
  }

  .nav-contact span {
    margin-left: 6px;
    color: var(--nav-orange);
  }

  .nav-toggle,
  .nav-drawer {
    display: none;
  }

  @media (max-width: 800px) {
    .nav-inner {
      grid-template-columns: 1fr auto;
    }

    .nav-links,
    .nav-contact {
      display: none;
    }

    .nav-toggle {
      width: 44px;
      height: 44px;
      display: grid;
      place-content: center;
      gap: 7px;
      border: 0;
      background: transparent;
      cursor: pointer;
    }

    .nav-toggle span {
      display: block;
      width: 22px;
      height: 1px;
      background: var(--nav-ink);
      transition: transform 180ms ease;
    }

    .nav.is-open .nav-toggle span:first-child {
      transform: translateY(4px) rotate(45deg);
    }

    .nav.is-open .nav-toggle span:last-child {
      transform: translateY(-4px) rotate(-45deg);
    }

    .nav-drawer {
      --nav-bg: #0b0a0d;
      --nav-ink: #f4f1eb;
      --nav-orange: #e99855;
      --nav-rule: #51454b;
      position: fixed;
      inset: 68px 0 0;
      z-index: 49;
      display: grid;
      align-content: start;
      padding: 28px clamp(24px, 5vw, 72px) 40px;
      border-top: 1px solid var(--nav-orange);
      background: var(--nav-bg);
      opacity: 0;
      pointer-events: none;
      transform: translateX(100%);
      transition: transform 220ms ease, opacity 160ms ease;
    }

    .nav-drawer.is-open {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(0);
    }

    .nav-drawer nav {
      display: grid;
    }

    .drawer-link {
      display: block;
      padding: 16px 0;
      border-bottom: 1px solid var(--nav-rule);
      color: var(--nav-ink);
      font-size: clamp(28px, 8vw, 44px);
      line-height: 1;
      letter-spacing: -0.06em;
      text-decoration: none;
    }

    .drawer-link::before {
      content: ">";
      display: inline-block;
      width: 1.2em;
      color: var(--nav-orange);
    }

    .drawer-link:hover,
    .drawer-link[aria-current="page"] {
      color: var(--nav-orange);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-drawer,
    .nav-toggle span {
      transition: none;
    }
  }
</style>

<script>
  const nav = document.querySelector("[data-nav]") as HTMLElement | null;
  const toggle = document.querySelector("[data-nav-toggle]") as HTMLButtonElement | null;
  const drawer = document.querySelector("[data-nav-drawer]") as HTMLElement | null;

  if (nav && toggle && drawer) {
    const close = () => {
      nav.classList.remove("is-open");
      drawer.classList.remove("is-open");
      drawer.setAttribute("aria-hidden", "true");
      drawer.inert = true;
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open navigation");
      document.body.style.overflow = "";
    };

    toggle.addEventListener("click", () => {
      const open = nav.classList.toggle("is-open");
      drawer.classList.toggle("is-open", open);
      drawer.setAttribute("aria-hidden", String(!open));
      drawer.inert = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
      document.body.style.overflow = open ? "hidden" : "";
    });

    drawer.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("is-open")) {
        close();
        toggle.focus();
      }
    });
    window.addEventListener("resize", () => {
      if (window.innerWidth > 800 && nav.classList.contains("is-open")) close();
    });
  }
</script>
