---
import { personal } from "../lib/data";

const path = Astro.url.pathname;
const isHome = path === "/" || path === "/index.html";
const navItems = [
  { label: "Work", href: isHome ? "#work" : "/#work" },
  { label: "Experience", href: isHome ? "#record" : "/#record" },
  { label: "About", href: isHome ? "#about" : "/#about" },
  { label: "Resume", href: isHome ? "#resume" : "/#resume" },
  { label: "Writing", href: "/blog" },
  { label: "Contact", href: isHome ? "#contact" : "/#contact" },
];
---

<header class="nav" data-nav>
  <div class="nav-inner">
    <a href="/" class="nav-name" aria-label={`${personal.name} — home`}>{personal.name}</a>
    <nav class="nav-links" aria-label="Primary">
      {navItems.map((item) => (
        <a href={item.href} aria-current={item.href === "/blog" && path.startsWith("/blog") ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
    <button class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-navigation" data-nav-toggle>Menu</button>
  </div>
  <div id="mobile-navigation" class="nav-drawer" data-nav-drawer aria-hidden="true" inert>
    <nav aria-label="Mobile navigation">
      {navItems.map((item) => (
        <a href={item.href} aria-current={item.href === "/blog" && path.startsWith("/blog") ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--rule); background: var(--bg); color: var(--ink); font-family: var(--font-sans); }
  .nav-inner { width: min(100%, 1120px); min-height: 68px; margin-inline: auto; padding-inline: 48px; display: flex; align-items: center; justify-content: space-between; gap: 32px; }
  .nav-name { flex: none; font-size: 16px; font-weight: 500; letter-spacing: -.02em; text-decoration: none; }
  .nav-links { display: flex; flex-wrap: wrap; gap: 20px; }
  .nav-links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink-muted); font-size: 14px; text-decoration: none; }
  .nav a:hover, .nav a[aria-current="page"] { color: var(--accent); }
  .nav-toggle, .nav-drawer { display: none; }
  @media (max-width: 800px) {
    .nav { position: static; }
    .nav[data-enhanced] { position: sticky; }
    .nav-inner { flex-wrap: wrap; gap: 0; padding-block: 12px; }
    .nav-links { width: 100%; gap: 0 20px; margin-top: 8px; }
    .nav[data-enhanced] .nav-inner { padding-block: 0; }
    .nav[data-enhanced] .nav-links { display: none; }
    .nav[data-enhanced] .nav-toggle { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; border: 0; padding: 8px 0 8px 12px; background: none; color: var(--ink); font: inherit; font-size: 14px; cursor: pointer; }
    .nav-drawer { position: fixed; inset: 68px 0 0; overflow-y: auto; padding: 16px 48px 32px; background: var(--bg); }
    .nav-drawer.is-open { display: block; }
    .nav-drawer nav { display: grid; }
    .nav-drawer a { display: flex; align-items: center; min-height: 56px; border-bottom: 1px solid var(--rule); font-size: 20px; text-decoration: none; }
  }
  @media (max-width: 700px) { .nav-inner { padding-inline: 24px; } .nav-drawer { padding-inline: 24px; } }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const drawer = document.querySelector<HTMLElement>("[data-nav-drawer]");

  if (nav && toggle && drawer) {
    nav.dataset.enhanced = "true";
    let previousOverflow = "";
    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";
    const close = (restoreFocus = false) => {
      drawer.classList.remove("is-open");
      drawer.setAttribute("aria-hidden", "true");
      drawer.inert = true;
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open navigation");
      toggle.textContent = "Menu";
      document.body.style.overflow = previousOverflow;
      if (restoreFocus) toggle.focus();
    };
    toggle.addEventListener("click", () => {
      if (isOpen()) { close(true); return; }
      previousOverflow = document.body.style.overflow;
      drawer.classList.add("is-open");
      drawer.setAttribute("aria-hidden", "false");
      drawer.inert = false;
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Close navigation");
      toggle.textContent = "Close";
      document.body.style.overflow = "hidden";
      drawer.querySelector<HTMLAnchorElement>("a")?.focus();
    });
    drawer.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => close(true)));
    document.addEventListener("keydown", (event) => {
      if (!isOpen()) return;
      if (event.key === "Escape") { event.preventDefault(); close(true); }
      if (event.key === "Tab") {
        const links = [...drawer.querySelectorAll<HTMLAnchorElement>("a")];
        const last = links[links.length - 1];
        if (event.shiftKey && document.activeElement === toggle) { event.preventDefault(); last?.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); toggle.focus(); }
      }
    });
    window.addEventListener("resize", () => { if (window.innerWidth > 800 && isOpen()) close(); });
  }
</script>
