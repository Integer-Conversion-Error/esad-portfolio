---
import { personal } from "../lib/data";
---

<footer class="footer">
  <div class="footer-inner">
    <a href={`mailto:${personal.email}`}>{personal.email}</a>
    <nav aria-label="Profile links">
      <a href={personal.links.github} target="_blank" rel="noopener">GitHub <span class="external-label">(opens in new tab)</span></a>
      <a href={personal.links.linkedin} target="_blank" rel="noopener">LinkedIn <span class="external-label">(opens in new tab)</span></a>
    </nav>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--rule); background: var(--bg); color: var(--ink-muted); font-family: var(--font-sans); }
  .footer-inner { width: min(100%, 1120px); margin-inline: auto; padding: 28px 48px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 32px; font-size: 14px; }
  .footer nav { display: flex; gap: 24px; }
  .footer a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; overflow-wrap: anywhere; }
  .footer a:hover { color: var(--accent); }
  .external-label { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 700px) { .footer-inner { padding: 24px; flex-direction: column; align-items: flex-start; gap: 0; } }
</style>
