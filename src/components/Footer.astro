---
import { personal } from "../lib/data";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-main">
      <p class="footer-command"><span>$</span> contact</p>
      <a class="footer-email" href={`mailto:${personal.email}`}>{personal.email} <span aria-hidden="true">↗</span></a>
    </div>

    <div class="footer-bottom">
      <p>© {year} Esad Kaya</p>
      <nav aria-label="Footer links">
        <a href="/#work">Work</a>
        <a href="/blog">Writing</a>
        <a href={personal.links.github} target="_blank" rel="noopener">GitHub ↗</a>
        <a href={personal.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
      </nav>
      <a href="#main">↑ Top</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    --footer-bg: #0b0a0d;
    --footer-ink: #f4f1eb;
    --footer-muted: #b9adb1;
    --footer-orange: #e99855;
    --footer-rule: #51454b;
    border-top: 1px solid var(--footer-orange);
    background: var(--footer-bg);
    color: var(--footer-ink);
  }

  .footer-inner {
    width: min(100%, 1440px);
    margin: 0 auto;
    padding: clamp(64px, 8vw, 112px) clamp(24px, 5vw, 72px) 24px;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 24px;
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .footer-command,
  .footer-email,
  .footer-bottom {
    font-family: var(--font-mono);
  }

  .footer-command {
    color: var(--footer-ink);
    font-size: clamp(28px, 4vw, 56px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.065em;
  }

  .footer-command span {
    color: var(--footer-orange);
  }

  .footer-email {
    max-width: 100%;
    display: inline-flex;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--footer-orange);
    color: var(--footer-ink);
    font-size: clamp(16px, 1.7vw, 24px);
    line-height: 1.3;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .footer-email span {
    color: var(--footer-orange);
  }

  .footer-email:hover {
    color: var(--footer-orange);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 32px;
    padding-top: 22px;
    border-top: 1px solid var(--footer-rule);
    color: var(--footer-muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .footer-bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
  }

  .footer-bottom a {
    color: var(--footer-ink);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .footer-bottom a:hover {
    color: var(--footer-orange);
  }

  @media (max-width: 720px) {
    .footer-main {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 36px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
