---
// Inline SVG illustrations for each lead project.
// All monochrome with a single accent fill, 1-5px strokes, ~480x320 viewBox.

interface Props {
  hint: "raindropticon" | "raindrop-web" | "home-intercom" | "parkopticon" | "put-it-down" | "legend-flooring";
}

const { hint } = Astro.props;
---

{hint === "raindropticon" && (
  <img src="/images/raindropticon-logo.jpeg" alt="Raindropticon logo" class="illus" />
)}

{hint === "raindrop-web" && (
  <svg viewBox="0 0 480 320" role="img" aria-label="A browser window showing search results with the Raindrop Janitorial site ranked in the top three" class="illus">
    {/* Browser frame */}
    <g fill="none" stroke="currentColor" stroke-width="2">
      <rect x="40" y="30" width="400" height="260" rx="2" />
      {/* Title bar */}
      <line x1="40" y1="56" x2="440" y2="56" />
      {/* Window dots */}
      <circle cx="54" cy="43" r="2" fill="currentColor" stroke="none" opacity="0.5" />
      <circle cx="64" cy="43" r="2" fill="currentColor" stroke="none" opacity="0.5" />
      <circle cx="74" cy="43" r="2" fill="currentColor" stroke="none" opacity="0.5" />
      {/* URL bar */}
      <rect x="100" y="36" width="280" height="14" fill="none" stroke="currentColor" stroke-width="1" opacity="0.6" />
    </g>

    {/* URL bar text */}
    <text x="108" y="46" font-family="var(--font-mono)" font-size="8" fill="currentColor" opacity="0.55">
      google.com/search?q=janitorial+services+ottawa
    </text>

    {/* Result 1 — top result, highlighted (Raindrop's site) */}
    <g>
      <rect x="56" y="72" width="368" height="44" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="1.5" />
      {/* Position marker */}
      <text x="62" y="84" font-family="var(--font-mono)" font-size="8" fill="var(--accent)" font-weight="500">1.</text>
      {/* Title (the page title would render in blue, but we're monochrome with accent) */}
      <rect x="76" y="78" width="180" height="6" fill="var(--accent)" />
      {/* URL line */}
      <rect x="76" y="90" width="140" height="3" fill="currentColor" opacity="0.45" />
      <text x="76" y="97" font-family="var(--font-mono)" font-size="7" fill="currentColor" opacity="0.6">raindropjanitorial.com › services</text>
      {/* Snippet */}
      <rect x="76" y="103" width="340" height="3" fill="currentColor" opacity="0.3" />
      <rect x="76" y="109" width="280" height="3" fill="currentColor" opacity="0.3" />
    </g>

    {/* Result 2 */}
    <g opacity="0.55">
      <text x="62" y="133" font-family="var(--font-mono)" font-size="8" fill="currentColor">2.</text>
      <rect x="76" y="127" width="160" height="6" fill="currentColor" />
      <text x="76" y="146" font-family="var(--font-mono)" font-size="7" fill="currentColor" opacity="0.6">competitor-a.ca</text>
      <rect x="76" y="152" width="320" height="3" fill="currentColor" opacity="0.3" />
      <rect x="76" y="158" width="240" height="3" fill="currentColor" opacity="0.3" />
    </g>

    {/* Result 3 */}
    <g opacity="0.4">
      <text x="62" y="181" font-family="var(--font-mono)" font-size="8" fill="currentColor">3.</text>
      <rect x="76" y="175" width="140" height="6" fill="currentColor" />
      <text x="76" y="194" font-family="var(--font-mono)" font-size="7" fill="currentColor" opacity="0.6">competitor-b.com</text>
      <rect x="76" y="200" width="300" height="3" fill="currentColor" opacity="0.3" />
      <rect x="76" y="206" width="220" height="3" fill="currentColor" opacity="0.3" />
    </g>

    {/* Result 4 — faded, shows there are more */}
    <g opacity="0.22">
      <text x="62" y="229" font-family="var(--font-mono)" font-size="8" fill="currentColor">4.</text>
      <rect x="76" y="223" width="120" height="6" fill="currentColor" />
      <text x="76" y="242" font-family="var(--font-mono)" font-size="7" fill="currentColor" opacity="0.6">aggregator.example</text>
    </g>

    {/* Footer label */}
    <text x="240" y="280" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="currentColor" opacity="0.5" letter-spacing="0.1em">SEO · GEO · TOP 3</text>
  </svg>
)}

{hint === "home-intercom" && (
  <svg viewBox="0 0 480 320" role="img" aria-label="A house outline with two room nodes and a wave path between them" class="illus">
    {/* House outline */}
    <g fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="square" stroke-linejoin="miter">
      <path d="M 80 240 L 80 130 L 240 50 L 400 130 L 400 240 Z" />
      {/* Floor split */}
      <line x1="80" y1="180" x2="400" y2="180" />
    </g>

    {/* Wave path between rooms (audio packets) */}
    <path
      d="M 150 210 Q 175 195 200 210 T 250 210 T 300 210 T 350 210"
      fill="none"
      stroke="var(--accent)"
      stroke-width="1.5"
    />

    {/* Endpoint nodes */}
    <g>
      <circle cx="150" cy="210" r="6" fill="var(--bg)" stroke="currentColor" stroke-width="1.5" />
      <circle cx="150" cy="210" r="2" fill="var(--accent)" />
      <text x="150" y="232" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="currentColor" opacity="0.6">ESP32 · A</text>
    </g>
    <g>
      <circle cx="350" cy="210" r="6" fill="var(--bg)" stroke="currentColor" stroke-width="1.5" />
      <circle cx="350" cy="210" r="2" fill="var(--accent)" />
      <text x="350" y="232" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="currentColor" opacity="0.6">ESP32 · B</text>
    </g>

    {/* Hub */}
    <rect x="225" y="200" width="30" height="20" fill="var(--bg-sunken)" stroke="currentColor" stroke-width="1" />
    <text x="240" y="235" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="currentColor" opacity="0.6">HUB</text>

    {/* Title */}
    <text x="240" y="280" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="currentColor" opacity="0.6" letter-spacing="0.1em">LAN · UDP · 16 kHz</text>
  </svg>
)}

{hint === "parkopticon" && (
  <svg viewBox="0 0 480 320" role="img" aria-label="Street grid with parking spots, one filled in accent color" class="illus">
    {/* Streets — horizontal */}
    <g stroke="currentColor" stroke-width="2">
      <line x1="40" y1="80" x2="440" y2="80" />
      <line x1="40" y1="160" x2="440" y2="160" />
      <line x1="40" y1="240" x2="440" y2="240" />
    </g>
    {/* Streets — vertical */}
    <g stroke="currentColor" stroke-width="2">
      <line x1="120" y1="40" x2="120" y2="280" />
      <line x1="200" y1="40" x2="200" y2="280" />
      <line x1="280" y1="40" x2="280" y2="280" />
      <line x1="360" y1="40" x2="360" y2="280" />
    </g>

    {/* Parking spots (top row between streets) */}
    <g fill="none" stroke="currentColor" stroke-width="1" opacity="0.7">
      <rect x="124" y="44" width="72" height="32" />
      <rect x="204" y="44" width="72" height="32" />
      <rect x="284" y="44" width="72" height="32" />
    </g>
    {/* Parking spots (middle row) */}
    <g fill="none" stroke="currentColor" stroke-width="1" opacity="0.7">
      <rect x="44" y="124" width="72" height="32" />
      <rect x="124" y="124" width="72" height="32" />
      <rect x="364" y="124" width="72" height="32" />
    </g>
    {/* Parking spots (bottom row) */}
    <g fill="none" stroke="currentColor" stroke-width="1" opacity="0.7">
      <rect x="44" y="204" width="72" height="32" />
      <rect x="124" y="204" width="72" height="32" />
      <rect x="204" y="204" width="72" height="32" />
      <rect x="284" y="204" width="72" height="32" />
    </g>

    {/* Filled accent spot */}
    <rect x="204" y="124" width="72" height="32" fill="var(--accent)" opacity="0.85" />

    {/* Pin */}
    <g transform="translate(240 140)">
      <circle r="14" fill="none" stroke="var(--accent)" stroke-width="1" />
      <circle r="4" fill="var(--accent)" />
    </g>

    {/* Compass / scale */}
    <text x="40" y="304" font-family="var(--font-mono)" font-size="9" fill="currentColor" opacity="0.5" letter-spacing="0.1em">N ↑</text>
    <text x="440" y="304" text-anchor="end" font-family="var(--font-mono)" font-size="9" fill="currentColor" opacity="0.5" letter-spacing="0.1em">100m</text>
  </svg>
)}

{hint === "put-it-down" && (
  <svg viewBox="0 0 480 320" role="img" aria-label="Webcam viewport frame with face mesh dots at eye, nose, and mouth positions" class="illus">
    {/* Webcam viewport */}
    <rect x="60" y="40" width="360" height="240" fill="var(--bg-sunken)" stroke="currentColor" stroke-width="2" />

    {/* Viewfinder corners */}
    <g stroke="currentColor" stroke-width="2" fill="none">
      <path d="M 60 60 L 60 40 L 80 40" />
      <path d="M 400 40 L 420 40 L 420 60" />
      <path d="M 420 260 L 420 280 L 400 280" />
      <path d="M 80 280 L 60 280 L 60 260" />
    </g>

    {/* Face mesh outline */}
    <ellipse cx="240" cy="160" rx="56" ry="72" fill="none" stroke="currentColor" stroke-width="1" opacity="0.5" />

    {/* Face mesh dots */}
    <g fill="currentColor">
      {/* Eyes */}
      <circle cx="222" cy="142" r="2.5" />
      <circle cx="258" cy="142" r="2.5" />
      {/* Nose */}
      <circle cx="240" cy="166" r="2" />
      {/* Mouth */}
      <circle cx="232" cy="188" r="1.8" />
      <circle cx="240" cy="190" r="1.8" />
      <circle cx="248" cy="188" r="1.8" />
      {/* Jaw */}
      <circle cx="220" cy="206" r="1.5" />
      <circle cx="232" cy="214" r="1.5" />
      <circle cx="248" cy="214" r="1.5" />
      <circle cx="260" cy="206" r="1.5" />
      {/* Cheek / forehead */}
      <circle cx="240" cy="118" r="1.5" />
      <circle cx="216" cy="126" r="1.5" opacity="0.5" />
      <circle cx="264" cy="126" r="1.5" opacity="0.5" />
    </g>

    {/* Highlighted accent — looking-at-phone indicator */}
    <circle cx="240" cy="166" r="4" fill="none" stroke="var(--accent)" stroke-width="1.5" />

    {/* Label */}
    <text x="240" y="304" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="currentColor" opacity="0.5" letter-spacing="0.1em">HEAD POSE · ACTIVE APP</text>
  </svg>
)}

{hint === "legend-flooring" && (
  <svg viewBox="0 0 480 320" role="img" aria-label="Three server rectangles connected by a line to a globe outline, depicting request flow" class="illus">
    {/* Browser / client */}
    <g transform="translate(40 130)">
      <rect width="80" height="60" fill="none" stroke="currentColor" stroke-width="1.5" />
      <line x1="0" y1="14" x2="80" y2="14" stroke="currentColor" stroke-width="1.5" />
      <circle cx="8" cy="7" r="2" fill="currentColor" opacity="0.5" />
      <circle cx="16" cy="7" r="2" fill="currentColor" opacity="0.5" />
      <circle cx="24" cy="7" r="2" fill="currentColor" opacity="0.5" />
      <text x="40" y="40" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="currentColor" opacity="0.6">CLIENT</text>
    </g>

    {/* Cloudflare */}
    <g transform="translate(170 130)">
      <rect width="80" height="60" fill="none" stroke="currentColor" stroke-width="1.5" />
      <text x="40" y="32" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="currentColor">CF</text>
      <text x="40" y="46" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="currentColor" opacity="0.6">edge</text>
    </g>

    {/* Tailscale */}
    <g transform="translate(170 210)">
      <rect width="80" height="50" fill="none" stroke="currentColor" stroke-width="1.5" />
      <text x="40" y="28" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="currentColor">TAIL</text>
      <text x="40" y="40" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="currentColor" opacity="0.6">funnel</text>
    </g>

    {/* API + SPA (the box) */}
    <g transform="translate(300 130)">
      <rect width="120" height="140" fill="none" stroke="currentColor" stroke-width="1.5" />
      <line x1="0" y1="70" x2="120" y2="70" stroke="currentColor" stroke-width="1" />
      <text x="60" y="42" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="currentColor">SPA · Vite</text>
      <text x="60" y="110" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="currentColor">API · Express</text>
    </g>

    {/* Globe */}
    <g transform="translate(360 60)">
      <circle r="20" fill="none" stroke="currentColor" stroke-width="1.5" />
      <ellipse cx="0" cy="0" rx="20" ry="8" fill="none" stroke="currentColor" stroke-width="1" opacity="0.6" />
      <line x1="-20" y1="0" x2="20" y2="0" stroke="currentColor" stroke-width="1" opacity="0.6" />
      <line x1="0" y1="-20" x2="0" y2="20" stroke="currentColor" stroke-width="1" opacity="0.6" />
    </g>

    {/* Connection lines */}
    <g stroke="var(--accent)" stroke-width="1.5" fill="none">
      <path d="M 120 160 L 170 160" />
      <path d="M 250 160 L 300 160" />
      <path d="M 210 190 L 210 210" />
      <path d="M 360 200 L 360 80" />
    </g>

    {/* Endpoint nodes */}
    <g fill="var(--accent)">
      <circle cx="170" cy="160" r="2.5" />
      <circle cx="210" cy="210" r="2.5" />
      <circle cx="300" cy="160" r="2.5" />
      <circle cx="360" cy="80" r="2.5" />
    </g>

    {/* Footer */}
    <text x="240" y="304" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="currentColor" opacity="0.5" letter-spacing="0.1em">CLOUDFLARE → TAILSCALE → CADDY</text>
  </svg>
)}

<style>
  .illus {
    width: 100%;
    height: auto;
    max-height: 320px;
    color: var(--ink);
    display: block;
  }

  img.illus {
    width: auto;
    max-width: 200px;
    max-height: 200px;
    margin: 60px auto 0;
    object-fit: contain;
  }
</style>
