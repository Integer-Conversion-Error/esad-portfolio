---
import type { Project } from "../lib/data";

interface Props {
  hint: Project["visualHint"];
}

const { hint } = Astro.props;

// Website captures: legendflooring.ca and www.raindropjanitorial.com, 2026-11-26.
// App capture: Put-It-Down commit 95631071, running its original Tkinter UI
// without webcam hardware or tracked activity.
const screenshots = {
  "put-it-down": {
    src: "/images/put-it-down-app.webp",
    title: "Put It Down",
    alt: "Put It Down dashboard with head-pose controls, tracked applications, and a block list; webcam feed unavailable.",
    width: 1000,
    height: 700,
  },
  "legend-flooring": {
    src: "/images/legend-flooring-live.webp",
    title: "Legend Flooring",
    alt: "Legend Flooring's live homepage with featured flooring, catalogue browsing, and a quote request link.",
    width: 1440,
    height: 1000,
  },
  "raindrop-web": {
    src: "/images/raindrop-janitorial-live.webp",
    title: "Raindrop Janitorial",
    alt: "Raindrop Janitorial's live homepage with commercial cleaning services and a quote request link.",
    width: 1440,
    height: 1000,
  },
};
const screenshot = hint in screenshots ? screenshots[hint as keyof typeof screenshots] : undefined;

const diagrams = {
  "home-intercom": {
    src: "/images/home-intercom-diagram.svg",
    title: "Home Intercom",
    alt: "Illustrated Home Intercom audio flow from a kitchen wall station through the local hub to another room.",
  },
  "parkopticon": {
    src: "/images/parkopticon-diagram.svg",
    title: "Parkopticon",
    alt: "Illustrated parking map with an open curbside space and a nearby enforcement alert zone.",
  },
};
const diagram = hint in diagrams ? diagrams[hint as keyof typeof diagrams] : undefined;
---

{screenshot && (
  <a class="project-screenshot-link" href={screenshot.src} target="_blank" rel="noopener" aria-label={`Open full-size ${screenshot.title} screenshot`}>
    <img src={screenshot.src} alt={screenshot.alt} width={screenshot.width} height={screenshot.height} class="project-screenshot" decoding="async" />
  </a>
)}

{diagram && (
  <a class="project-diagram-link" href={diagram.src} target="_blank" rel="noopener" aria-label={`Open full-size ${diagram.title} diagram`}>
    <img src={diagram.src} alt={diagram.alt} width="640" height="420" class="project-diagram" decoding="async" />
  </a>
)}

{hint === "hack-the-nest" && (
  <img
    src="/images/hack-the-nest-fleet-map.webp"
    alt="The Fleet Lab street grid with two van routes, a charging stop, and delivery markers."
    class="fleet-map-screenshot"
    width="620"
    height="475"
  />
)}

{hint === "raindropticon" && (
  <img src="/images/raindropticon-logo.jpeg" alt="Raindropticon logo" class="illus" />
)}

<style>
  .project-screenshot-link, .project-diagram-link { display: block; width: 100%; }
  .project-screenshot, .project-diagram {
    display: block;
    width: 100%;
    height: auto;
    max-height: 260px;
    object-fit: contain;
  }

  .illus {
    width: 100%;
    height: auto;
    max-height: 320px;
    color: var(--ink);
    display: block;
  }

  img.illus {
    width: auto;
    max-width: 200px;
    max-height: 200px;
    margin: 60px auto 0;
    object-fit: contain;
  }

  .fleet-map-screenshot {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 260px;
    object-fit: contain;
  }

  @media (max-width: 700px) {
    .fleet-map-screenshot, .project-screenshot, .project-diagram { max-height: 220px; }
  }
</style>
