---
import { caseStudies, caseStudyHref, type CaseStudy } from "../lib/case-studies";
import { personal } from "../lib/data";

interface Props { project: CaseStudy }
const { project } = Astro.props;
const nextProject = caseStudies[(caseStudies.findIndex((item) => item.slug === project.slug) + 1) % caseStudies.length];
---

<div class="study" id="top">
  <a class="study-skip" href="#project-content">Skip to case study</a>
  <header class="study-nav">
    <div class="study-shell study-nav-inner">
      <a href="/" aria-label="Esad Kaya - home">EK</a>
      <nav aria-label="Primary">
        <a href="/#work">Work</a>
        <a href="/blog/">Writing</a>
        <a href="/#contact">Contact</a>
      </nav>
    </div>
  </header>

  <article class="study-shell" id="project-content" aria-labelledby="project-title">
    <header class="study-hero">
      <a class="study-back" href="/#work">← Selected work</a>
      <p class="study-path"><span aria-hidden="true">$ </span>work/{project.slug}/</p>
      <h1 id="project-title">{project.title}</h1>
      <p class="study-summary">{project.summary}</p>
      <dl class="study-facts">
        <div><dt>Status</dt><dd>{project.status}</dd></div>
        <div><dt>My work</dt><dd>{project.role}</dd></div>
      </dl>
      {project.url && <a class="study-live" href={project.url} target="_blank" rel="noopener noreferrer">Visit live site <span aria-hidden="true">↗</span></a>}
    </header>

    <nav class="study-contents" aria-label="On this page">
      <a href="#purpose">Purpose</a>
      <a href="#contribution">My contribution</a>
      <a href="#architecture">Architecture</a>
      <a href="#challenge">Challenge</a>
      <a href="#outcome">Outcome</a>
      <a href="#technologies">Technologies</a>
    </nav>

    <section class="study-section" id="purpose" aria-labelledby="purpose-title">
      <h2 id="purpose-title">The purpose</h2>
      <p>{project.purpose}</p>
    </section>
    <section class="study-section" id="contribution" aria-labelledby="contribution-title">
      <h2 id="contribution-title">My contribution</h2>
      <p>{project.contribution}</p>
    </section>
    <section class="study-section" id="architecture" aria-labelledby="architecture-title">
      <h2 id="architecture-title">Architecture & decisions</h2>
      <div class="study-section-body">
        <p>{project.architecture}</p>
        <figure class="study-diagram">
          <ol aria-label={`${project.title} architecture flow`}>
            {project.flow.map((step, index) => <li><span class="study-step">{String(index + 1).padStart(2, "0")}</span><span>{step}</span></li>)}
          </ol>
          <figcaption>{project.flowNote}</figcaption>
        </figure>
      </div>
    </section>
    <section class="study-section" id="challenge" aria-labelledby="challenge-title">
      <h2 id="challenge-title">The challenge</h2>
      <p>{project.challenge}</p>
    </section>
    <section class="study-section" id="outcome" aria-labelledby="outcome-title">
      <h2 id="outcome-title">Outcome & remaining work</h2>
      <div class="study-section-body">
        <p>{project.outcome}</p>
        <p class="study-limit">{project.next}</p>
      </div>
    </section>
    <section class="study-section" id="technologies" aria-labelledby="technologies-title">
      <h2 id="technologies-title">Technologies</h2>
      <p>{project.stack.join(" / ")}</p>
    </section>

    <footer class="study-footer">
      <a href="/#work">← All selected work</a>
      <a href={caseStudyHref(nextProject.slug)}>Next: {nextProject.title} <span aria-hidden="true">→</span></a>
      <a href={`mailto:${personal.email}`}>Discuss this project <span aria-hidden="true">↗</span></a>
    </footer>
  </article>
</div>

<style>
  .study { background: var(--bg); color: var(--ink); font-family: var(--font-mono); min-height: 100vh; }
  .study h1, .study h2 { font-family: var(--font-mono); }
  .study a { color: var(--accent); text-decoration: none; transition: color 160ms ease; }
  .study a:hover { color: var(--accent-hover); text-decoration: underline; text-underline-offset: 6px; }
  .study-shell { width: min(100%, 1440px); padding-inline: 72px; margin-inline: auto; }
  .study-skip { position: fixed; top: 12px; left: 12px; z-index: 50; padding: 12px; background: var(--bg); transform: translateY(-200%); }
  .study-skip:focus { transform: translateY(0); }
  .study-nav { border-bottom: 1px solid var(--rule); }
  .study-nav-inner { min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .study-nav nav { display: flex; gap: 28px; }
  .study-nav a { min-height: 44px; display: inline-flex; align-items: center; font-size: 15px; color: var(--ink); }
  .study-hero { padding-block: 48px 56px; }
  .study-back { display: inline-flex; min-height: 44px; align-items: center; font-size: 15px; }
  .study-path { margin-top: 40px; color: var(--ink-muted); font-size: 17px; overflow-wrap: anywhere; }
  .study-path span { color: var(--accent); }
  .study h1 { margin-top: 18px; max-width: 18ch; font-size: 64px; line-height: 1.12; letter-spacing: -.065em; overflow-wrap: anywhere; }
  .study-summary { max-width: 48ch; margin-top: 24px; font-size: 24px; line-height: 1.5; letter-spacing: -.035em; }
  .study-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; max-width: 1000px; margin-top: 40px; }
  .study-facts div { border-top: 1px solid var(--rule); padding-top: 16px; }
  .study-facts dt { color: var(--accent); font-size: 15px; }
  .study-facts dd { margin: 10px 0 0; font-size: 16px; line-height: 1.6; }
  .study-live { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; margin-top: 24px; font-size: 16px; }
  .study-contents { display: flex; flex-wrap: wrap; gap: 6px 28px; padding-block: 16px; border-top: 1px solid var(--accent); border-bottom: 1px solid var(--rule); }
  .study-contents a { display: inline-flex; min-height: 44px; align-items: center; font-size: 15px; }
  .study-section { display: grid; grid-template-columns: minmax(180px, .55fr) minmax(0, 1fr); gap: 48px; padding-block: 48px; border-bottom: 1px solid var(--rule); scroll-margin-top: 24px; }
  .study h2 { font-size: 25px; line-height: 1.35; letter-spacing: -.035em; max-width: 18ch; }
  .study-section p { max-width: 66ch; font-size: 16px; line-height: 1.85; margin: 0; }
  .study-section-body { min-width: 0; }
  .study-section-body .study-limit { margin-top: 24px; color: var(--ink-muted); }
  .study-diagram { margin: 32px 0 0; }
  .study-diagram ol { list-style: none; padding: 0; margin: 0; }
  .study-diagram li { display: flex; gap: 20px; align-items: baseline; border-left: 2px solid var(--accent); padding: 16px 20px; background: var(--bg-elevated); font-size: 16px; line-height: 1.6; }
  .study-diagram li + li { margin-top: 12px; }
  .study-step { color: var(--accent); flex: none; }
  .study-diagram figcaption { margin-top: 16px; color: var(--ink-muted); font-size: 14px; line-height: 1.7; }
  .study-footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px 32px; padding-block: 40px 56px; }
  .study-footer a { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; font-size: 15px; }
  @media (max-width: 1100px) { .study-shell { padding-inline: 48px; } .study h1 { font-size: 56px; } .study-section { gap: 32px; } }
  @media (max-width: 700px) {
    .study-shell { padding-inline: 24px; }
    .study-nav nav { gap: 18px; }
    .study-nav a { font-size: 14px; }
    .study-hero { padding-block: 28px 36px; }
    .study-path { margin-top: 28px; font-size: 15px; }
    .study h1 { font-size: 38px; }
    .study-summary { font-size: 20px; }
    .study-facts { grid-template-columns: 1fr; gap: 20px; margin-top: 28px; }
    .study-section { grid-template-columns: 1fr; gap: 20px; padding-block: 32px; }
    .study h2 { max-width: none; font-size: 23px; }
    .study-diagram li { padding: 14px 16px; gap: 12px; }
    .study-footer { flex-direction: column; align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) { .study a { transition: none; } }
</style>
