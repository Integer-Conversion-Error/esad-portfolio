---
import { caseStudies, caseStudyHref, type CaseStudy } from "../lib/case-studies";
import { personal } from "../lib/data";
import Nav from "./Nav.astro";

interface Props { project: CaseStudy }
const { project } = Astro.props;
const nextProject = caseStudies[(caseStudies.findIndex((item) => item.slug === project.slug) + 1) % caseStudies.length];
---

<div class="study" id="top">
  <a class="study-skip" href="#project-content">Skip to case study</a>
  <Nav />

  <article class="study-shell" id="project-content" aria-labelledby="project-title">
    <header class="study-hero">
      <h1 id="project-title">{project.title}</h1>
      <p class="study-summary">{project.summary}</p>
      <dl class="study-facts">
        <div><dt>Status</dt><dd>{project.status}</dd></div>
        <div><dt>My work</dt><dd>{project.role}</dd></div>
      </dl>
      {(project.url || project.github || project.devpost) && (
        <div class="study-project-links">
          {project.url && <a href={project.url} target="_blank" rel="noopener noreferrer">Visit live site <span aria-hidden="true">↗</span></a>}
          {project.github && <a href={project.github} target="_blank" rel="noopener noreferrer">View source <span aria-hidden="true">↗</span></a>}
          {project.devpost && <a href={project.devpost} target="_blank" rel="noopener noreferrer">Demo on Devpost <span aria-hidden="true">↗</span></a>}
        </div>
      )}
    </header>

    <nav class="study-contents" aria-label="On this page">
      <a href="#purpose">Purpose</a>
      <a href="#contribution">My contribution</a>
      <a href="#architecture">Architecture</a>
      <a href="#challenge">Challenge</a>
      <a href="#outcome">Outcome</a>
      <a href="#technologies">Technologies</a>
    </nav>

    {project.screenshot && (
      <figure class="study-screenshot">
        <img src={project.screenshot.src} alt={project.screenshot.alt} width={project.screenshot.width} height={project.screenshot.height} />
        <figcaption>{project.screenshot.caption}</figcaption>
      </figure>
    )}

    <section class="study-section" id="purpose" aria-labelledby="purpose-title">
      <h2 id="purpose-title">The purpose</h2>
      <p>{project.purpose}</p>
    </section>
    <section class="study-section" id="contribution" aria-labelledby="contribution-title">
      <h2 id="contribution-title">My contribution</h2>
      <p>{project.contribution}</p>
    </section>
    <section class="study-section" id="architecture" aria-labelledby="architecture-title">
      <h2 id="architecture-title">Architecture & decisions</h2>
      <div class="study-section-body">
        <p>{project.architecture}</p>
        <figure class="study-diagram">
          <ol aria-label={`${project.title} architecture flow`}>
            {project.flow.map((step) => <li>{step}</li>)}
          </ol>
          <figcaption>{project.flowNote}</figcaption>
        </figure>
      </div>
    </section>
    <section class="study-section" id="challenge" aria-labelledby="challenge-title">
      <h2 id="challenge-title">The challenge</h2>
      <p>{project.challenge}</p>
    </section>
    <section class="study-section" id="outcome" aria-labelledby="outcome-title">
      <h2 id="outcome-title">Outcome & remaining work</h2>
      <div class="study-section-body">
        <p>{project.outcome}</p>
        <p class="study-limit">{project.next}</p>
      </div>
    </section>
    <section class="study-section" id="technologies" aria-labelledby="technologies-title">
      <h2 id="technologies-title">Technologies</h2>
      <p>{project.stack.join(" / ")}</p>
    </section>

    <footer class="study-footer">
      <a href="/#work">← All selected work</a>
      <a href={caseStudyHref(nextProject.slug)}>Next: {nextProject.title} <span aria-hidden="true">→</span></a>
      <a href={`mailto:${personal.email}`}>Discuss this project <span aria-hidden="true">↗</span></a>
    </footer>
  </article>
</div>

<style>
  .study { background: var(--bg); color: var(--ink); font-family: var(--font-sans); min-height: 100vh; }
  .study h1, .study h2 { font-family: var(--font-sans); }
  .study-shell a { color: var(--accent); text-decoration: none; transition: color 160ms ease; }
  .study-shell a:hover { color: var(--accent-hover); text-decoration: underline; text-underline-offset: 5px; }
  .study-shell { width: min(100%, 1120px); padding-inline: 48px; margin-inline: auto; }
  .study-skip { position: fixed; top: 12px; left: 12px; z-index: 100; padding: 12px; background: var(--bg); color: var(--ink); transform: translateY(-200%); }
  .study-skip:focus { transform: translateY(0); }
  .study-hero { padding-block: 56px 32px; }
  .study h1 { max-width: 22ch; font-size: clamp(34px, 4.5vw, 48px); line-height: 1.15; letter-spacing: -.04em; overflow-wrap: anywhere; }
  .study-summary { max-width: 60ch; margin-top: 16px; font-size: 20px; line-height: 1.6; }
  .study-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 40px; margin: 28px 0 0; }
  .study-facts dt { color: var(--ink-muted); font-family: var(--font-mono); font-size: 13px; }
  .study-facts dd { margin: 8px 0 0; font-size: 16px; line-height: 1.6; }
  .study-project-links { display: flex; flex-wrap: wrap; gap: 0 24px; margin-top: 16px; }
  .study-project-links a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 15px; }
  .study-contents { display: flex; flex-wrap: wrap; gap: 0 24px; padding-block: 8px; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .study-contents a { display: inline-flex; min-height: 44px; align-items: center; font-size: 14px; }
  .study-screenshot { margin: 0; padding-block: 32px; border-bottom: 1px solid var(--rule); }
  .study-screenshot img { display: block; width: 100%; height: auto; }
  .study-screenshot figcaption { margin-top: 12px; color: var(--ink-muted); font-size: 14px; line-height: 1.7; }
  .study-section { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 40px; padding-block: 32px; border-bottom: 1px solid var(--rule); scroll-margin-top: 88px; }
  .study h2 { font-size: 18px; line-height: 1.5; letter-spacing: -.02em; }
  .study-section p { max-width: 68ch; font-size: 16px; line-height: 1.8; margin: 0; }
  .study-section-body { min-width: 0; }
  .study-section-body .study-limit { margin-top: 16px; color: var(--ink-muted); }
  .study-diagram { margin: 20px 0 0; }
  .study-diagram ol { padding-left: 24px; margin: 0; list-style: decimal; }
  .study-diagram li { padding-left: 4px; font-size: 16px; line-height: 1.8; }
  .study-diagram li + li { margin-top: 6px; }
  .study-diagram li::marker { color: var(--ink-muted); }
  .study-diagram figcaption { margin-top: 16px; color: var(--ink-muted); font-size: 14px; line-height: 1.7; }
  .study-footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding-block: 24px 40px; }
  .study-footer a { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; font-size: 14px; }
  @media (max-width: 700px) {
    .study-shell { padding-inline: 24px; }
    .study-hero { padding-block: 40px 28px; }
    .study-summary { font-size: 18px; }
    .study-facts { grid-template-columns: 1fr; gap: 20px; margin-top: 24px; }
    .study-contents { gap: 0 20px; }
    .study-screenshot { padding-block: 24px; }
    .study-section { grid-template-columns: 1fr; gap: 12px; padding-block: 28px; }
    .study-footer { flex-direction: column; align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) { .study-shell a { transition: none; } }
</style>
