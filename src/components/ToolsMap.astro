---
import { experience, leadProjects, skills, smallProjects } from "../lib/data";
import { caseStudies } from "../lib/case-studies";

const knownTools = new Set(skills.flatMap((group) => group.items));
const groups = [
  { key: "languages", label: "Languages", items: ["Python", "TypeScript", "JavaScript", "Java", "C/C++", "SQL"] },
  { key: "web", label: "Web + mobile", items: ["React", "React Native", "Expo", "Node.js", "NestJS", "GraphQL", "Flask"] },
  { key: "data", label: "Data + vision", items: ["Redis", "NumPy", "Pandas", "ONNX Runtime", "OpenCV", "MediaPipe", "YOLOv8", "Power BI"] },
  { key: "hardware", label: "Hardware", items: ["ESP32", "Orange Pi", "Arduino", "mmWave radar", "KiCAD", "3D printing"] },
  { key: "delivery", label: "Delivery", items: ["Docker", "Linux", "Cloudflare", "AWS EC2", "Tailscale", "Git/GitHub", "CI/CD"] },
  { key: "desktop", label: "Desktop + testing", items: ["PyQt", "Tkinter", "Matplotlib", "Playwright", "Selenium", "Jest"] },
].map((group) => ({ ...group, items: group.items.filter((tool) => knownTools.has(tool)) }));

const aliases: Record<string, string> = {
  "c++": "c/c++",
  "esp32-s3": "esp32",
  "esp32-wrover": "esp32",
  "orange pi 5": "orange pi",
  "onnx": "onnx runtime",
  "react 19": "react",
};
const normalize = (tool: string) => aliases[tool.toLowerCase()] ?? tool.toLowerCase();

type Work = { slug: string; title: string; stack: Set<string>; github?: string };
const projects = new Map<string, Work>();
// Merge the homepage and case-study stacks rather than counting a project twice.
for (const project of [...leadProjects, ...caseStudies, ...smallProjects]) {
  const previous = projects.get(project.slug);
  projects.set(project.slug, {
    slug: project.slug,
    title: previous?.title ?? project.title,
    stack: new Set([...(previous?.stack ?? []), ...project.stack.map(normalize)]),
    github: previous?.github ?? project.github,
  });
}
const projectList = [...projects.values()];
const extraProjectTools: Record<string, string[]> = {
  // These are named in the existing project narratives, outside the short stacks.
  "mmwave radar": ["parkopticon"],
  "ci/cd": ["raindropticon"],
};
const workTools = [
  { tool: "Java", company: "Entrust", slug: "experience-entrust" },
  { tool: "Redis", company: "Entrust", slug: "experience-entrust" },
  { tool: "Jest", company: "Entrust", slug: "experience-entrust" },
  { tool: "PyQt", company: "Communications Research Center", slug: "experience-crc" },
  { tool: "Power BI", company: "HR – Infrastructure Canada", slug: "experience-infrastructure-canada" },
];
const usesTool = (project: Work, tool: string) => {
  const normalized = normalize(tool);
  return project.stack.has(normalized)
    || extraProjectTools[normalized]?.includes(project.slug)
    || (tool === "Git/GitHub" && Boolean(project.github));
};

const tools = groups.flatMap((group) => group.items.map((name) => {
  const matches = projectList.filter((project) => usesTool(project, name));
  const roles = workTools.filter((work) => work.tool === name && experience.some((role) => role.company === work.company)).map((work) => ({
    title: work.company,
    href: `#${work.slug}`,
    kind: "Experience",
  }));
  const links = [
    ...matches.map((project) => ({ title: project.title, href: `#${project.slug}`, kind: "Project" })),
    ...roles,
  ];
  const related = links.length ? [] : projectList
    .filter((project) => group.items.some((tool) => usesTool(project, tool)))
    .slice(0, 3)
    .map((project) => ({ title: project.title, href: `#${project.slug}`, kind: "Project" }));
  return {
    name,
    group: group.key,
    category: group.label,
    projects: matches.length,
    links,
    related,
    size: matches.length >= 4 ? "frequent" : matches.length >= 2 ? "recurring" : "standard",
  };
}));
const initial = tools.find((tool) => tool.name === "Python")!;
const serialized = JSON.stringify(tools).replace(/</g, "\\u003c");
---

<div class="tools-map" data-tools-map>
  <div class="tools-map-intro">
    <p class="tools-map-note" data-tools-interactive hidden>Select a tool to see where I use it.</p>
    <p class="tools-map-note" data-tools-static>Larger names appear in more projects.</p>
    <span class="tools-map-total" aria-hidden="true">{tools.length} tools <span>·</span> {projectList.length} projects</span>
  </div>
  <div class="tools-map-filters" role="group" aria-label="Filter tools by area" data-tools-filters hidden>
    <button type="button" data-tools-filter="all" aria-pressed="true">All</button>
    {groups.map((group) => <button type="button" data-tools-filter={group.key} aria-pressed="false">{group.label}</button>)}
  </div>

  <div class="tools-map-explorer">
    <div class="tools-map-groups">
      {groups.map((group, index) => (
        <section class="tools-map-group" aria-labelledby={`tools-group-${index}`} data-tools-group={group.key}>
          <h3 id={`tools-group-${index}`}>{group.label}</h3>
          <ul>
            {tools.filter((tool) => tool.group === group.key).map((tool) => (
              <li class={tool.size}>
                <button
                  type="button"
                  data-tool={tool.name}
                  aria-pressed={tool.name === initial.name ? "true" : "false"}
                  aria-controls="tool-connections"
                  disabled
                >{tool.name}</button>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <aside class="tools-map-connections" id="tool-connections" aria-label="Projects and experience using the selected tool">
      <div class="tools-map-selection">
        <p class="tools-map-category" data-tools-category>{initial.category}</p>
        <h3 data-tools-selected>{initial.name}</h3>
        <div class="tools-map-trace" aria-hidden="true"><span></span><i></i></div>
        <p class="tools-map-count" data-tools-count>{initial.projects} projects</p>
      </div>
      <p class="tools-map-context" data-tools-context hidden></p>
      <ol class="tools-map-links" data-tools-links>
        {initial.links.map((link) => (
          <li><a href={link.href}><span>{link.title}</span><span aria-hidden="true">↗</span></a></li>
        ))}
      </ol>
      <p class="tools-map-related-title" data-tools-related-title hidden>Related projects</p>
      <ol class="tools-map-links" data-tools-related hidden></ol>
      <p class="tools-map-status" role="status" aria-live="polite" aria-atomic="true" data-tools-status></p>
    </aside>
  </div>
  <script is:inline type="application/json" data-tools-data set:html={serialized}></script>
</div>

<script>
  type ToolLink = { title: string; href: string; kind: string };
  type Tool = { name: string; group: string; category: string; projects: number; links: ToolLink[]; related: ToolLink[] };

  document.querySelectorAll<HTMLElement>("[data-tools-map]").forEach((map) => {
    const payload = map.querySelector<HTMLScriptElement>("[data-tools-data]");
    if (!payload?.textContent) return;
    const tools: Tool[] = JSON.parse(payload.textContent);
    const buttons = [...map.querySelectorAll<HTMLButtonElement>("[data-tool]")];
    const filters = [...map.querySelectorAll<HTMLButtonElement>("[data-tools-filter]")];
    const groups = [...map.querySelectorAll<HTMLElement>("[data-tools-group]")];
    const selected = map.querySelector<HTMLElement>("[data-tools-selected]")!;
    const category = map.querySelector<HTMLElement>("[data-tools-category]")!;
    const count = map.querySelector<HTMLElement>("[data-tools-count]")!;
    const list = map.querySelector<HTMLOListElement>("[data-tools-links]")!;
    const context = map.querySelector<HTMLElement>("[data-tools-context]")!;
    const relatedTitle = map.querySelector<HTMLElement>("[data-tools-related-title]")!;
    const relatedList = map.querySelector<HTMLOListElement>("[data-tools-related]")!;
    const status = map.querySelector<HTMLElement>("[data-tools-status]")!;
    let activeTool = "Python";

    const renderLinks = (target: HTMLElement, links: ToolLink[]) => {
      target.replaceChildren(...links.map((link) => {
        const item = document.createElement("li");
        const anchor = document.createElement("a");
        const title = document.createElement("span");
        const arrow = document.createElement("span");
        anchor.href = link.href;
        title.textContent = link.title;
        arrow.textContent = "↗";
        arrow.setAttribute("aria-hidden", "true");
        anchor.append(title, arrow);
        if (link.kind === "Experience") {
          const label = document.createElement("small");
          label.textContent = "Experience";
          title.append(document.createElement("br"), label);
        }
        item.append(anchor);
        return item;
      }));
    };

    const selectTool = (name: string, announce = true) => {
      const tool = tools.find((item) => item.name === name);
      if (!tool) return;
      activeTool = name;
      buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.tool === name)));
      selected.textContent = name;
      category.textContent = tool.category;
      const projectCount = `${tool.projects} project${tool.projects === 1 ? "" : "s"}`;
      const roles = tool.links.filter((link) => link.kind === "Experience").length;
      count.textContent = tool.projects ? projectCount : roles ? "At work" : "In my toolkit";
      context.textContent = tool.links.length ? "" : "Not covered in these project write-ups.";
      context.hidden = Boolean(tool.links.length);
      list.hidden = !tool.links.length;
      renderLinks(list, tool.links);
      relatedTitle.hidden = !tool.related.length;
      relatedList.hidden = !tool.related.length;
      renderLinks(relatedList, tool.related);
      if (announce) status.textContent = `${name}: ${tool.projects} linked project${tool.projects === 1 ? "" : "s"}${roles ? ` and ${roles} experience` : ""}.`;
    };

    const filterTools = (key: string) => {
      filters.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.toolsFilter === key)));
      groups.forEach((group) => { group.hidden = key !== "all" && group.dataset.toolsGroup !== key; });
      if (key !== "all" && tools.find((tool) => tool.name === activeTool)?.group !== key) {
        const first = tools.filter((tool) => tool.group === key).sort((a, b) => b.links.length - a.links.length)[0];
        if (first) selectTool(first.name);
      }
    };

    buttons.forEach((button) => {
      button.disabled = false;
      button.addEventListener("click", () => selectTool(button.dataset.tool!));
    });
    filters.forEach((button) => button.addEventListener("click", () => filterTools(button.dataset.toolsFilter!)));
    map.querySelector<HTMLElement>("[data-tools-filters]")!.hidden = false;
    map.querySelector<HTMLElement>("[data-tools-interactive]")!.hidden = false;
    map.querySelector<HTMLElement>("[data-tools-static]")!.hidden = true;
    map.classList.add("is-interactive");
    if (window.matchMedia("(max-width: 680px)").matches) filterTools("languages");
    selectTool(activeTool, false);
  });
</script>

<style>
  .tools-map { font-family: var(--font-mono); }
  .tools-map [hidden] { display: none !important; }
  .tools-map-intro { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
  .tools-map-note, .tools-map-total {
    margin: 0;
    color: var(--tp-muted, var(--ink-muted));
    font-size: 14px;
    line-height: 1.7;
  }
  .tools-map-total { flex-shrink: 0; font-size: 12px; }
  .tools-map-total span { padding-inline: 6px; color: var(--tp-orange, var(--accent)); }
  .tools-map-filters { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-bottom: 36px; }
  .tools-map-filters button {
    padding: 8px 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: var(--tp-muted, var(--ink-muted));
    font: inherit;
    font-size: 12px;
    line-height: 1.5;
    cursor: pointer;
  }
  .tools-map-filters button:hover, .tools-map-filters button[aria-pressed="true"] { color: var(--tp-orange, var(--accent)); border-bottom-color: currentColor; }
  .tools-map-explorer { display: grid; grid-template-columns: minmax(0, 1fr) minmax(250px, .46fr); gap: 48px; align-items: start; }
  .tools-map-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 28px; }
  .tools-map-group { min-width: 0; padding-top: 18px; border-top: 1px solid var(--tp-rule, var(--rule)); }
  .tools-map-group h3 { margin: 0 0 12px; color: var(--tp-orange, var(--accent)); font-family: var(--font-mono); font-size: 12px; font-weight: 400; line-height: 1.5; }
  .tools-map-group ul { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; padding: 0; margin: 0; list-style: none; }
  .tools-map-group li { max-width: 100%; font-size: 14px; line-height: 1.5; }
  .tools-map-group li.recurring { font-size: 18px; }
  .tools-map-group li.frequent { font-size: 25px; letter-spacing: -.035em; }
  .tools-map-group button {
    display: inline-block;
    max-width: 100%;
    min-height: 36px;
    padding: 4px 0;
    border: 0;
    border-bottom: 1px solid transparent;
    border-radius: 0;
    background: transparent;
    color: var(--tp-muted, var(--ink-muted));
    font: inherit;
    line-height: 1.5;
    letter-spacing: inherit;
    text-align: left;
    overflow-wrap: anywhere;
  }
  .tools-map-group .recurring button, .tools-map-group .frequent button { color: var(--tp-paper, var(--ink)); }
  .tools-map-group button:enabled { cursor: pointer; }
  .tools-map-group button:enabled:hover { color: var(--tp-orange, var(--accent)); }
  .is-interactive .tools-map-group button[aria-pressed="true"] { color: var(--tp-orange, var(--accent)); border-bottom-color: currentColor; }
  .tools-map button:focus-visible, .tools-map :global(a:focus-visible) { outline: 2px solid var(--tp-orange, var(--accent)); outline-offset: 5px; }
  .tools-map-connections { position: relative; padding: 18px 0 0 28px; border-top: 1px solid var(--tp-orange, var(--accent)); border-left: 1px solid var(--tp-rule, var(--rule)); }
  .tools-map-connections::before { content: ""; position: absolute; width: 5px; height: 5px; left: -3px; top: -3px; border-radius: 50%; background: var(--tp-orange, var(--accent)); }
  .tools-map-category { margin: 0 0 10px; color: var(--tp-muted, var(--ink-muted)); font-size: 12px; line-height: 1.5; }
  .tools-map-selection h3 { margin: 0; color: var(--tp-orange, var(--accent)); font-family: var(--font-mono); font-size: clamp(25px, 2.4vw, 34px); font-weight: 400; line-height: 1.25; letter-spacing: -.045em; overflow-wrap: anywhere; }
  .tools-map-trace { display: flex; align-items: center; width: 66px; height: 22px; margin-top: 8px; color: var(--tp-orange, var(--accent)); }
  .tools-map-trace span { width: 5px; height: 5px; border: 1px solid currentColor; border-radius: 50%; }
  .tools-map-trace i { flex: 1; height: 1px; background: var(--tp-rule, var(--rule)); }
  .tools-map-trace i::after { content: ""; display: block; width: 4px; height: 4px; margin: -1px 0 0 auto; border-right: 1px solid currentColor; border-top: 1px solid currentColor; transform: rotate(45deg); }
  .tools-map-count { margin: 0 0 12px; color: var(--tp-muted, var(--ink-muted)); font-size: 12px; line-height: 1.5; }
  .tools-map-context { margin: 0 0 24px; color: var(--tp-muted, var(--ink-muted)); font-size: 13px; line-height: 1.8; }
  .tools-map-links { padding: 0; margin: 0; list-style: none; }
  .tools-map-links :global(a) { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 0; border-top: 1px solid var(--tp-rule, var(--rule)); color: var(--tp-paper, var(--ink)); font-size: 14px; line-height: 1.65; text-decoration: none; }
  .tools-map-links :global(a:hover) { color: var(--tp-orange, var(--accent)); }
  .tools-map-links :global(a > span:last-child) { color: var(--tp-orange, var(--accent)); }
  .tools-map-links :global(small) { color: var(--tp-muted, var(--ink-muted)); font-size: 11px; }
  .tools-map-related-title { margin: 0 0 12px; color: var(--tp-muted, var(--ink-muted)); font-size: 12px; line-height: 1.5; }
  .tools-map-status { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; clip-path: inset(50%); overflow: hidden; white-space: nowrap; }
  @media (max-width: 1080px) {
    .tools-map-explorer { grid-template-columns: minmax(0, 1fr) minmax(220px, .48fr); gap: 28px; }
    .tools-map-groups { grid-template-columns: 1fr; gap: 24px; }
    .tools-map-connections { padding-left: 20px; }
    .tools-map-filters { gap: 4px 18px; margin-bottom: 28px; }
  }
  @media (max-width: 680px) {
    .tools-map-intro { display: block; margin-bottom: 18px; }
    .tools-map-total { display: block; margin-top: 8px; }
    .tools-map-explorer { grid-template-columns: 1fr; gap: 28px; }
    .tools-map-groups { gap: 24px; }
    .tools-map-group { padding-top: 16px; }
    .tools-map-group li.frequent { font-size: 24px; }
    .tools-map-group button { min-height: 44px; }
    .tools-map-filters { gap: 2px 16px; margin-bottom: 24px; }
    .tools-map-filters button { min-height: 44px; }
    .tools-map-connections { padding: 18px 0 0; border-left: 0; }
    .tools-map-connections::before { left: 0; }
    .tools-map-selection { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; column-gap: 16px; }
    .tools-map-category { grid-column: 1 / -1; }
    .tools-map-selection h3 { grid-row: 2; font-size: 28px; }
    .tools-map-trace { display: none; }
    .tools-map-count { grid-row: 2; margin: 0; }
    .tools-map-context { margin-top: 14px; }
    .tools-map-links { margin-top: 16px; }
    .tools-map-links :global(a) { padding-block: 13px; }
  }
</style>
