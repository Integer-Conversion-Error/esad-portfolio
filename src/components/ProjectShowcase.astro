---
import { leadProjects } from "../lib/data";
import ProjectVisual from "./ProjectVisual.astro";

// Each project alternates visual/text placement per the design:
//   odd  (1,3,5): visual cols 1-7,  text cols 8-12
//   even (2,4):   visual cols 6-12, text cols 1-5
const placementFor = (index: number): "left" | "right" =>
  index % 2 === 0 ? "left" : "right";
---

<section id="work" class="showcase" aria-label="Selected projects">
  <div class="showcase-rail" aria-hidden="true">
    <span class="rail-fill" data-showcase-rail></span>
  </div>

  {
    leadProjects.map((project, i) => {
      const place = placementFor(i);
      return (
        <article
          class={`project-pin ${place}`}
          data-project-pin
          data-index={String(i).padStart(2, "0")}
          aria-labelledby={`p-${project.slug}`}
        >
          <div class="pin-spacer"></div>

          <div class="pin-sticky">
            <div class="container pin-grid-wrap">
              <div class="pin-grid">
                <div class="pin-visual" data-project-visual>
                  <span class="micro index-tag">
                    {String(i + 1).padStart(2, "0")} / {String(leadProjects.length).padStart(2, "0")}
                  </span>
                  <ProjectVisual hint={project.visualHint} />
                </div>

                <div class="pin-text" data-project-text>
                  <p class="micro muted">{project.role}</p>
                  <h3 id={`p-${project.slug}`} class="pin-title">
                    {project.title}
                  </h3>
                  <p class="pin-subtitle">{project.subtitle}</p>
                  <p class="pin-narrative">{project.narrative}</p>

                  <dl class="pin-meta">
                    <div>
                      <dt class="micro">Year</dt>
                      <dd class="caption tabular">{project.year}</dd>
                    </div>
                    <div>
                      <dt class="micro">Stack</dt>
                      <dd class="caption mono">{project.stack.join(" · ")}</dd>
                    </div>
                  </dl>

                  <div class="pin-links">
                    {project.url && (
                      <a href={project.url} class="link-arrow" rel="noopener" target="_blank">
                        Visit →
                      </a>
                    )}
                    {project.github && (
                      <a href={project.github} class="link-arrow" rel="noopener" target="_blank">
                        Source →
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </article>
      );
    })
  }
</section>

<style>
  .showcase {
    position: relative;
    border-top: 1px solid var(--rule);
  }

  /* Right-edge progress rail */
  .showcase-rail {
    position: fixed;
    top: 0;
    right: clamp(16px, 3vw, 32px);
    width: 1px;
    height: 100vh;
    z-index: 5;
    background: var(--rule);
    pointer-events: none;
  }

  .rail-fill {
    display: block;
    width: 1px;
    height: 100%;
    background: var(--ink);
    transform: scaleY(0);
    transform-origin: top;
  }

  /* Per-project wrapper — auto height, no GSAP pin, no pin-spacers.
     Each project is a self-contained card that fades in on scroll. */
  .project-pin {
    position: relative;
    height: auto;
    padding-top: clamp(64px, 12vw, 128px);
    padding-bottom: clamp(64px, 12vw, 128px);
  }

  .pin-spacer {
    display: none;
  }

  .pin-sticky {
    position: static;
    height: auto;
    display: block;
  }

  /* Default: odd projects — visual cols 1-7, text cols 8-12 */
  .pin-visual {
    grid-column: 1 / -1;
  }
  .pin-text {
    grid-column: 1 / -1;
  }

  /* Desktop: visual and text split into 12-col grid */
  @media (min-width: 900px) {
    .project-pin.right .pin-visual {
      grid-column: 1 / span 7;
    }
    .project-pin.right .pin-text {
      grid-column: 8 / -1;
    }

    .project-pin.left .pin-visual {
      grid-column: 6 / -1;
      order: 2;
    }
    .project-pin.left .pin-text {
      grid-column: 1 / span 5;
      order: 1;
    }
  }

  .pin-grid-wrap {
    width: 100%;
  }

  .pin-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 24px;
    row-gap: 32px;
    align-items: center;
  }

  /* Default: odd projects — visual cols 1-7, text cols 8-12 */
  .pin-visual {
    grid-column: 1 / -1;
  }
  .pin-text {
    grid-column: 1 / -1;
  }

  /* Even projects — visual right, text left */
  @media (min-width: 900px) {
    .project-pin.right .pin-visual {
      grid-column: 1 / span 7;
    }
    .project-pin.right .pin-text {
      grid-column: 8 / -1;
    }

    .project-pin.left .pin-visual {
      grid-column: 6 / -1;
      order: 2;
    }
    .project-pin.left .pin-text {
      grid-column: 1 / span 5;
      order: 1;
    }
  }

  .pin-visual {
    position: relative;
    padding: 32px;
    background: var(--bg-elevated);
    border: 1px solid var(--rule);
  }

  .index-tag {
    position: absolute;
    top: 12px;
    left: 16px;
    color: var(--ink-subtle);
    z-index: 1;
  }

  .pin-text {
    max-width: 36rem;
  }

  .pin-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.2;
    letter-spacing: -0.015em;
    font-weight: 500;
    margin: 8px 0 4px;
    color: var(--ink);
  }

  .pin-subtitle {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-muted);
    margin: 0 0 24px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .pin-narrative {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink);
    margin: 0 0 32px;
  }

  .pin-meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin: 0 0 24px;
    padding: 16px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 600px) {
    .pin-meta {
      grid-template-columns: auto 1fr;
    }
  }

  .pin-meta dt {
    color: var(--ink-subtle);
    margin-bottom: 4px;
  }

  .pin-meta dd {
    margin: 0;
    color: var(--ink);
  }

  .pin-meta .mono {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .pin-links {
    display: flex;
    gap: 24px;
  }

  .link-arrow {
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink);
    position: relative;
    padding: 12px 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: color var(--duration-instant) var(--ease-standard);
  }

  .link-arrow::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(1);
    transform-origin: right;
    transition: transform var(--duration-medium) var(--ease-standard);
  }

  .link-arrow:hover {
    color: var(--accent);
  }
  .link-arrow:hover::after {
    transform: scaleX(0);
    transform-origin: right;
  }
</style>
