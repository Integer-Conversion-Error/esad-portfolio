---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  draft?: boolean;
}

const { title, description, pubDate, draft = false } = Astro.props;

const formatDate = (date: Date): string =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<BaseLayout title={`${title} — Esad Kaya`} description={description}>
  <article class="post">
    <header class="post-head container">
      <a href="/blog" class="post-command"><span>esad@ottawa:~$</span> cd writing/ <span aria-hidden="true">↵</span></a>
      <h1 class="post-title">{title}</h1>
      <p class="post-desc">{description}</p>
      <p class="post-meta">
        <time datetime={pubDate.toISOString()} class="tabular">{formatDate(pubDate)}</time>
        {draft && <span class="draft-badge">Draft</span>}
      </p>
    </header>

    <div class="post-body container">
      <div class="prose">
        <slot />
      </div>

      <hr class="post-rule" />

      <a href="/blog" class="back-link">← Writing</a>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .post {
    --bg: #0b0a0d;
    --bg-elevated: #171319;
    --ink: #f4f1eb;
    --ink-muted: #b9adb1;
    --ink-subtle: #a89a9f;
    --rule: #51454b;
    --rule-strong: #e99855;
    --accent: #e99855;
    padding-top: clamp(72px, 9vw, 128px);
    padding-bottom: clamp(96px, 12vw, 160px);
    background: var(--bg);
    color: var(--ink);
  }

  .post-head {
    max-width: 1280px;
    margin: 0 auto clamp(48px, 7vw, 88px);
    padding-bottom: clamp(48px, 6vw, 80px);
    border-bottom: 1px solid var(--accent);
  }

  .post-command {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: clamp(14px, 1.5vw, 18px);
    line-height: 1.5;
    letter-spacing: -0.05em;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: clamp(32px, 5vw, 56px);
    transition: color 160ms ease;
  }

  .post-command span {
    color: var(--accent);
  }

  .post-command:hover,
  .back-link:hover {
    color: var(--accent);
  }

  .post-title {
    max-width: 24ch;
    font-family: var(--font-mono);
    font-size: clamp(40px, 6.5vw, 80px);
    line-height: 1.08;
    letter-spacing: -0.075em;
    font-weight: 500;
    color: var(--ink);
    margin: 0 0 28px;
    overflow-wrap: anywhere;
  }

  .post-desc {
    max-width: 68ch;
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0 0 28px;
  }

  .post-meta {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: -0.015em;
    color: var(--ink-subtle);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .draft-badge {
    display: inline-block;
    padding: 2px 8px;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .post-body {
    max-width: 900px;
  }

  .prose {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.75;
    color: var(--ink);
  }

  .prose > * + * {
    margin-top: 24px;
  }

  .prose h2 {
    font-family: var(--font-mono);
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.25;
    letter-spacing: -0.065em;
    font-weight: 500;
    color: var(--ink);
    margin-top: 64px;
    margin-bottom: 16px;
  }

  .prose h3 {
    font-family: var(--font-mono);
    font-size: 23px;
    line-height: 1.3;
    letter-spacing: -0.05em;
    font-weight: 500;
    color: var(--ink);
    margin-top: 48px;
    margin-bottom: 12px;
  }

  .prose p {
    margin: 0;
  }

  .prose > p + p {
    margin-top: 24px;
  }

  .prose a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 1px;
    overflow-wrap: anywhere;
    word-break: break-word;
    transition: color var(--duration-instant) var(--ease-standard), border-color var(--duration-instant) var(--ease-standard);
  }

  .prose a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .prose em {
    font-style: italic;
    color: var(--ink);
  }

  .prose strong {
    font-weight: 600;
    color: var(--ink);
  }

  .prose blockquote {
    margin: 32px 0;
    padding: 0 0 0 24px;
    border-left: 2px solid var(--accent);
    color: var(--ink-muted);
    font-style: italic;
  }

  .prose code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--bg-elevated);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    color: var(--accent);
  }

  .prose pre {
    font-family: var(--font-mono);
    background: var(--bg-elevated);
    border: 1px solid var(--rule);
    padding: 20px;
    border-radius: var(--radius-sm);
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.55;
  }

  .prose pre code {
    background: transparent;
    padding: 0;
    color: var(--ink);
  }

  .prose ul,
  .prose ol {
    padding-left: 24px;
    margin: 0;
  }

  .prose li {
    margin: 8px 0;
  }

  .prose hr {
    margin: 64px 0;
    border: 0;
    border-top: 1px solid var(--rule);
  }

  .post-rule {
    margin: 96px 0 32px;
    border: 0;
    border-top: 1px solid var(--accent);
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--ink);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .post-figure {
    margin: 64px 0;
    padding: 32px 0 8px;
    border-top: 1px solid var(--accent);
    display: grid;
    gap: 24px;
  }

  .stat-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }

  @media (max-width: 720px) {
    .stat-row {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stat-num {
    font-family: var(--font-mono);
    font-size: clamp(48px, 6vw, 72px);
    line-height: 1;
    letter-spacing: -0.065em;
    color: var(--accent);
    font-weight: 500;
  }

  .stat-label {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.4;
    color: var(--ink-muted);
  }

  .stat-source {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-subtle);
    margin-top: 4px;
  }

  .bar-chart {
    width: 100%;
    height: auto;
    display: block;
  }

  .bar-chart text {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--ink);
  }

  .bar-chart .chart-title {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 500;
    fill: var(--ink);
    letter-spacing: -0.04em;
  }

  .bar-chart .row-label {
    fill: var(--ink-muted);
  }

  .bar-chart .row-value {
    fill: var(--ink);
  }

  .bar-chart .bar-line {
    fill: var(--ink-subtle);
  }

  .bar-chart .bar-line-strong {
    fill: var(--accent);
  }

  .figure-caption {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-muted);
    margin: 0;
    max-width: 56rem;
  }

  @media (max-width: 720px) {
    .prose {
      font-size: 17px;
      line-height: 1.72;
    }

    .post-title {
      letter-spacing: -0.075em;
    }

    .post-figure {
      overflow-x: auto;
    }

    .bar-chart {
      min-width: 620px;
    }
  }
</style>
