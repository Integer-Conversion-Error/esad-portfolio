---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => data.draft !== true);
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const formatDate = (date: Date): string => date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<BaseLayout title="Writing — Esad Kaya" description="Essays and project notes by Esad Kaya.">
  <section class="blog" aria-labelledby="blog-title">
    <div class="blog-inner">
      <h1 id="blog-title">Writing</h1>
      {allPosts.length === 0 ? <p class="empty">No posts yet.</p> : (
        <ul class="list">
          {allPosts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="item-link">
                <span class="item-main">
                  <h2>{post.data.title}</h2>
                  <span class="item-description">{post.data.description}</span>
                </span>
                <time class="date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog { min-height: 65vh; padding-block: 72px 96px; }
  .blog-inner { width: min(100%, 1120px); margin-inline: auto; padding-inline: 48px; }
  .blog h1 { margin-bottom: 40px; font-family: var(--font-sans); font-size: 48px; line-height: 1.2; letter-spacing: -.04em; }
  .empty { color: var(--ink-muted); }
  .list { padding: 0; margin: 0; list-style: none; }
  .list li { border-top: 1px solid var(--rule); }
  .item-link { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px; align-items: baseline; padding-block: 28px; text-decoration: none; }
  .item-link h2 { font-family: var(--font-sans); font-size: 24px; font-weight: 500; line-height: 1.35; letter-spacing: -.025em; }
  .item-link:hover h2 { color: var(--accent); }
  .item-description { display: block; max-width: 66ch; margin-top: 8px; color: var(--ink-muted); font-size: 16px; line-height: 1.6; }
  .date { color: var(--ink-muted); font-family: var(--font-mono); font-size: 13px; white-space: nowrap; }
  @media (max-width: 700px) {
    .blog { padding-block: 48px 64px; }
    .blog-inner { padding-inline: 24px; }
    .blog h1 { margin-bottom: 28px; font-size: 36px; }
    .item-link { grid-template-columns: 1fr; gap: 12px; padding-block: 24px; }
    .item-link h2 { font-size: 22px; }
  }
</style>
