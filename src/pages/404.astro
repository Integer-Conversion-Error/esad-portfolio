---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Esad Kaya" description="Page not found.">
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="not-found-inner">
      <h1 id="not-found-title">Page not found</h1>
      <a href="/">← Back home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { min-height: 60vh; padding-block: 96px; }
  .not-found-inner { width: min(100%, 1120px); margin-inline: auto; padding-inline: 48px; }
  .not-found h1 { font-family: var(--font-sans); font-size: clamp(32px, 5vw, 48px); line-height: 1.2; letter-spacing: -.035em; }
  .not-found a { display: inline-flex; align-items: center; min-height: 44px; margin-top: 24px; color: var(--accent); font-size: 16px; }
  .not-found a:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 700px) { .not-found { padding-block: 64px; } .not-found-inner { padding-inline: 24px; } }
</style>
