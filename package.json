{
  "name": "esad-portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:worker": "npm run build && wrangler dev",
    "types:worker": "wrangler types src/worker-configuration.d.ts",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name esad-portfolio",
    "deploy:worker": "npm run build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.125.0"
  }
}
